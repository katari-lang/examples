// standup-scribe: a Slack standup scribe, as one small resident. Every weekday a schedule fiber
// opens the standup and the desk collects the replies threaded under the prompt; when the window
// closes, one model step drafts the digest and the facilitator posts, rewrites or discards it.

import ai
import ai.types
import ai.anthropic
import slack

// ─── configuration ────────────────────────────────────────────────────────────────────────────────

@"Everything read from the env at boot, as one value carried into the schedule fiber."
data settings(
  standup_channel: string,
  @"Where the review question and every operator-facing note go; may equal the standup channel." facilitator_channel: string,
  @"The weekday hour (0-23) the window opens, read in @timezone@." standup_hour: integer,
  @"The IANA zone the schedule and the digest's date are read in." timezone: string,
  window_minutes: integer,
)

@"One env entry the scribe cannot run on, named and diagnosed. Thrown at boot, because a bad hour or
zone would otherwise panic inside the schedule fiber, which supervises itself back into the panic."
data bad_config(name: string, detail: string)

@"A fiber died on an error no guard folds. `region.failed` re-raises it, so the run stops loudly."
data fiber_failure(name: string, detail: string)

// Everything the composition root anticipates stopping on. (Type synonyms take no docs.)
type app_error =
  slack.slack_error | env.missing_secret | oauth.server_error | bad_config | fiber_failure

// One env entry as a whole number; unset and unparseable both answer the fallback. Range is boot's.
agent whole_number(key: string, fallback: integer) {
  match (string.to_integer(value = string.trim(value = env.get_or(key = key, fallback = "")))) {
    case null -> fallback
    case value -> value
  }
}

// ─── the bus ──────────────────────────────────────────────────────────────────────────────────────

@"The scribe desk's inbox for channel traffic: one incoming Slack message, reported by the watcher."
request channel_message(author: string, text: string, thread: string | null) -> null

@"Open the day's window at the desk: from now on, collect the replies threaded under @prompt_ts@."
request window_started(date: string, prompt_ts: string) -> null

@"Close the window at the desk and take the collected entries; the desk goes idle."
request window_finished() -> array[entry]

effect scribe_scope

// What the schedule fiber may raise: window controls, Slack, the model seam, its marker's store rows.
// (Type synonyms take no docs.)
type schedule_effects =
  window_started | window_finished | slack.credential | ai.infer_step | store.get | store.set | io

// The nursery's ceiling is every fiber kind's row. (Type synonyms take no docs.)
type fiber_ceiling = channel_message | schedule_effects

// ─── the desk's state ─────────────────────────────────────────────────────────────────────────────

@"One collected standup reply: who wrote it, by their Slack user id, and what they wrote."
data entry(author: string, text: string)

@"No window is open: channel chatter is none of the scribe's business."
data idle()

@"A window is open: replies threaded under @prompt_ts@ are collected until the schedule closes it."
data collecting(date: string, prompt_ts: string, entries: array[entry])

// The scribe desk's whole state. (Type synonyms take no docs.)
type window_state = idle | collecting

// ─── the day's window, as the store remembers it ──────────────────────────────────────────────────

@"One window as the store remembers it — the thread entries hang under, and the instant it closes —
so a window outlives the fiber that opened it."
data recorded_window(prompt_ts: string, close_at: number)

@"Nothing is recorded for the date, so no window is open and there is none to resume."
data no_window()

// What one date's marker says. (Type synonyms take no docs.)
type marker = recorded_window | no_window

// The marker's stored shape — an object, so the row reads in the console. (Type synonyms: no docs.)
type marker_row = { prompt_ts: string, close_at: number }

@"Nothing is recorded yet, so this run posts the prompt and writes the marker itself."
data open_fresh(close_at: number)

// Where one run gets its window: it opens one, or picks up the store's. (Type synonyms: no docs.)
type opening = open_fresh | recorded_window

// The occurrence that writes a window and the recovery that reads it must name it identically.
agent marker_key(date: string) {
  f"standup/prompts/${date}"
}

// An absent row and one this version cannot read both say `no_window`, so the day opens fresh.
agent read_marker(date: string) {
  match (store.get_or[marker_row | null](key = marker_key(date = date), fallback = null)) {
    case null -> no_window()
    case row -> recorded_window(prompt_ts = row.prompt_ts, close_at = row.close_at)
  }
}

// ─── failure discipline ───────────────────────────────────────────────────────────────────────────

// What an occurrence folds into a note rather than dying on; not auth, which repeats tomorrow.
// (Type synonyms take no docs.)
type occurrence_trouble =
  ai.provider_error | http.api_error | http.fetch_error | json.parse_error | slack.api_error

// The throws one occurrence lets fly: the fiber dies and the run stops. (Type synonyms: no docs.)
type occurrence_fatal = bad_config | slack.auth_error | http.auth_error

// One line in front of the facilitator; a dropped note has nowhere left to be reported, and a dead
// token still stops the scribe, because `try_send` re-raises `auth_error`.
agent tell_facilitator(channel: string, text: string) {
  match (slack.try_send(channel = channel, text = text)) {
    case slack.delivered(_) -> null
    case slack.dropped(reason => _) -> null
  }
}

// ─── the sources ──────────────────────────────────────────────────────────────────────────────────

// Serve the standup channel forever, reporting every message to the desk, which owns the collection
// policy. The watch opens the Socket Mode connection, so a token Slack refuses is a throw from here.
agent channel_watcher(channel: string) -> never with channel_message | slack.credential | io | prelude.throw[slack.slack_error] {
  use supervise.forever()
  use supervise.signal_panics[never]()
  slack.watch_messages(channel = channel, deliver_to = agent (value: slack.message) {
    channel_message(author = value.author, text = value.text, thread = value.thread)
  })
}

// The schedule fiber: pick up any window an earlier instance left open, then fire every weekday at
// the configured hour. `time.watch` serializes deliveries, so an occurrence cannot overlap itself.
agent standup_schedule(configuration: settings) -> never with schedule_effects | prelude.throw[occurrence_fatal] {
  use supervise.forever()
  use supervise.signal_panics[never]()
  // The date an instant falls on, in the configured zone; boot validated it, so null is drift.
  agent date_of(instant: number) {
    match (time.zone_offset(epoch_milliseconds = instant, zone = configuration.timezone)) {
      case null -> prelude.throw(error = bad_config(name = "STANDUP_TIMEZONE", detail = f"the runtime's zone database no longer knows \"${configuration.timezone}\""))
      case minutes -> time.date_label(epoch_milliseconds = instant, offset_minutes = minutes)
    }
  }
  // Run one standup to its end. A scheduled occurrence and the recovery below both come here, so a
  // window that outlived its fiber ends exactly as the original would have.
  agent run_standup(date: string, opening: opening) {
    // One policy over the whole standup: a failure that can heal becomes one facilitator line, while
    // the fatal residual re-raises as bound and the fiber's death reaches `region.failed`.
    use handler {
      request prelude.throw(error: occurrence_trouble | occurrence_fatal) -> never {
        let line = match (error) {
          case ai.provider_error(source => source, message => message, transient => _, detail => _) -> f"the model provider failed (${source}: ${message})"
          case http.api_error(status => status, context => context, message => message) -> f"an http call was refused (${context}: ${string.to_string(value = status)} — ${message})"
          case http.fetch_error(message => message) -> f"the network dropped (${message})"
          case json.parse_error(message => message) -> f"a reply failed to parse (${message})"
          case slack.api_error(message => message) -> f"Slack refused a call (${message})"
          case rest -> prelude.throw(error = rest)
        }
        tell_facilitator(
          channel = configuration.facilitator_channel,
          text = f"(standup ${date}: gave up — ${line}. Nothing was posted; the schedule stays armed for the next weekday.)",
        )
        break null
      }
    }
    let window = match (opening) {
      // Recorded before anything is collected: a fiber's death can take the collection, never the
      // window itself.
      case open_fresh(close_at => close_at) -> {
        let posted = slack.send_message(
          channel = configuration.standup_channel,
          text = f"Standup time! Reply in this thread within ${string.to_string(value = configuration.window_minutes)} minutes: yesterday / today / blockers.",
        )
        store.set(key = marker_key(date = date), value = { prompt_ts = posted, close_at = close_at })
        recorded_window(prompt_ts = posted, close_at = close_at)
      }
      case rest -> rest
    }
    window_started(date = date, prompt_ts = window.prompt_ts)
    // Close at the instant the store holds: a resumed window ends when the original would have.
    time.sleep_until(time = window.close_at)
    let entries = window_finished()
    if (array.length(target = entries) == 0) {
      // Nobody replied: no model call, no review, one line so the silence reads as the team's.
      tell_facilitator(channel = configuration.facilitator_channel, text = f"(standup ${date}: no entries in the window — nothing to digest.)")
    } else {
      // Fit once: the cap is both what an ask's prompt fails at and the form field's own bound.
      let draft = string.fit(
        value = draft_digest(date = date, entries = entries),
        cap = slack.limits().message_text,
        marker = "\n… (cut to fit Slack's message cap)",
      )
      review_and_post(configuration = configuration, date = date, draft = draft)
    }
  }
  // One scheduled occurrence. @time@ is its scheduled epoch millisecond, not the delivery instant, so
  // the date and the close instant derived from it survive an at-least-once redelivery unchanged.
  agent occurrence(time: number) {
    let date = date_of(instant = time)
    let close_at = time + configuration.window_minutes * 60000
    match (read_marker(date = date)) {
      // Nothing recorded, and the window would already be over: this is the single catch-up `time.watch`
      // fires for an outage, so posting a prompt nobody can still reply to would only litter the channel.
      case no_window(_) -> {
        if (time.now() >= close_at) {
          tell_facilitator(channel = configuration.facilitator_channel, text = f"(standup ${date}: missed — the scribe was down for the whole window, so no prompt was posted.)")
        } else {
          run_standup(date = date, opening = open_fresh(close_at = close_at))
        }
      }
      // Recorded already: the same window re-opens and no second prompt goes out; a closed one is over.
      case rest -> {
        if (time.now() < rest.close_at) {
          run_standup(date = date, opening = rest)
        } else {
          null
        }
      }
    }
  }
  // The recovery runs before the watch: a fresh `time.watch` arms on the next occurrence, so today's
  // open window would be left with nobody to close it — and the store holds its lifetime too.
  let now = time.now()
  let today = date_of(instant = now)
  match (read_marker(date = today)) {
    case no_window(_) -> null
    case rest -> {
      if (now < rest.close_at) {
        run_standup(date = today, opening = rest)
      } else {
        // The ordinary state of every hour after a standup: there is nothing to say.
        null
      }
    }
  }
  time.watch(
    schedule = time.cron(
      expression = f"0 ${string.to_string(value = configuration.standup_hour)} * * 1-5",
      timezone = configuration.timezone,
    ),
    deliver_to = occurrence,
  )
}

// ─── the digest ───────────────────────────────────────────────────────────────────────────────────

// One model step, not a chat loop: nothing to converse about, and one step is one guard wide.
agent draft_digest(date: string, entries: array[entry]) {
  // Each author is written as a Slack mention, which the posted digest renders as their own name.
  let lines = for (let item in entries) {
    next f"<@${item.author}>: ${item.text}"
  }
  let briefing = string.join(parts = [
    f"Draft a compact standup digest for ${date} from the raw replies below.",
    "Group by author, copying each <@...> mention exactly as given, and keep each to a line or two in a yesterday / today / blockers shape where the reply supports it.",
    "Close with one shared-blockers line only if any blockers appeared. Output plain Slack mrkdwn, no preamble.",
    "Replies:",
    string.join(parts = lines, separator = "\n"),
  ], separator = "\n")
  ai.infer(history = [types.turn(role = types.user_role(), text = briefing)])
}

// Post as drafted, rewrite in place, or discard; the form's prefill is exactly what posts.
agent review_controls(draft: string) {
  [
    slack.button(id = "post", label = "Post it"),
    slack.button(id = "discard", label = "Discard"),
    slack.form(id = "edit", label = "Edit", title = "Standup digest", fields = [
      slack.field(id = "digest", label = "The digest, as it will post", value = draft, multiline = true),
    ]),
  ]
}

@"The facilitator's decision: the digest posts, at exactly @text@ — approved, or rewritten."
data post_approved(text: string)

@"The facilitator's decision, read: nothing posts, and @reason@ is the one line worth keeping."
data digest_discarded(reason: string)

// One review's outcome, read from the Slack answer once. (Type synonyms take no docs.)
type review = post_approved | digest_discarded

// Read the answer into the app's own sum, so acting on it is one dispatch. Ids are matched as
// literals — keys this program wrote, never display text — and a cleared draft reads as a discard.
agent read_review(answer: slack.answer, draft: string) {
  match (answer) {
    case slack.clicked(id => "post", by => _) -> post_approved(text = draft)
    case slack.submitted(id => _, values => values, by => _) -> {
      let edited = match (record.get(target = values, key = "digest")) {
        case null -> ""
        case text -> text
      }
      if (string.trim(value = edited) == "") {
        digest_discarded(reason = "the facilitator cleared the draft")
      } else {
        post_approved(text = edited)
      }
    }
    case rest -> digest_discarded(reason = "the facilitator pressed Discard")
  }
}

// The deadline: `time.watch` serializes deliveries, so an unanswered review must not hold tomorrow.
agent review_and_post(configuration: settings, date: string, draft: string) {
  agent hold_review() {
    slack.ask(
      channel = configuration.facilitator_channel,
      prompt = string.fit(
        value = f"Standup digest for ${date} — press *Post it*, open *Edit* to rewrite it, or *Discard*.\n\n${draft}",
        cap = slack.limits().message_text,
        marker = "\n… (preview cut; open Edit for the full draft)",
      ),
      controls = review_controls(draft = draft),
    )
  }
  // Six hours: generous for a human, comfortably inside the gap to the next weekday firing.
  match (time.with_deadline(milliseconds = 21600000, task = hold_review)) {
    case time.deadline_passed(_) -> {
      tell_facilitator(channel = configuration.facilitator_channel, text = f"(standup ${date}: the review expired unanswered after six hours — nothing was posted.)")
    }
    case time.completed(value => answer) -> {
      match (read_review(answer = answer, draft = draft)) {
        // A cleared draft leaves the form's own "Edit" beside the answered ask, which reads like an
        // edit that posted, so the reason says which of the two endings it was.
        case digest_discarded(reason => reason) -> {
          tell_facilitator(channel = configuration.facilitator_channel, text = f"(standup ${date}: nothing posted — ${reason}.)")
        }
        case post_approved(text => text) -> {
          match (slack.try_send(channel = configuration.standup_channel, text = text)) {
            case slack.delivered(_) -> null
            case slack.dropped(reason => reason) -> {
              // The approval already happened, so the failure carries the text for a hand post.
              tell_facilitator(channel = configuration.facilitator_channel, text = f"(standup ${date}: the approved digest did not post — ${reason}. Post it by hand:)\n${text}")
            }
          }
        }
      }
    }
  }
}

// ─── the composition root ─────────────────────────────────────────────────────────────────────────

@"Entry: validate the configuration, provide the model and the Slack credentials, install the desk,
the region and its policies, and serve until cancelled. Every anticipated stop is one readable line."
agent main() -> string {
  use handler { request panic(msg: string) { break f"standup-scribe stopped on a defect: ${msg}" } }
  use handler {
    request prelude.throw(error: app_error) -> never {
      break f"standup-scribe stopped: ${json.stringify(value = error)}"
    }
  }
  // Unset and empty are one case: both are a channel this scribe cannot post in.
  let standup_channel = string.trim(value = env.get_or(key = "STANDUP_CHANNEL", fallback = ""))
  if (standup_channel == "") {
    prelude.throw(error = bad_config(name = "STANDUP_CHANNEL", detail = "it is not set, and the scribe has nowhere to open the standup"))
  } else {
    null
  }
  let standup_hour = whole_number(key = "STANDUP_HOUR", fallback = 9)
  if (standup_hour < 0 || standup_hour > 23) {
    prelude.throw(error = bad_config(name = "STANDUP_HOUR", detail = f"${string.to_string(value = standup_hour)} is outside 0-23"))
  } else {
    null
  }
  // A window that closes as it opens reports "no entries" every weekday, which reads as a dead team.
  let window_minutes = whole_number(key = "WINDOW_MINUTES", fallback = 60)
  if (window_minutes < 1) {
    prelude.throw(error = bad_config(name = "WINDOW_MINUTES", detail = f"${string.to_string(value = window_minutes)} is not at least one minute"))
  } else {
    null
  }
  let timezone = env.get_or(key = "STANDUP_TIMEZONE", fallback = "UTC")
  // Validate the zone at boot: `time.cron` panics on a zone it does not know, and that panic would
  // land inside the schedule fiber, whose own supervisor would run it straight back into it.
  match (time.zone_offset(epoch_milliseconds = time.now(), zone = timezone)) {
    case null -> prelude.throw(error = bad_config(name = "STANDUP_TIMEZONE", detail = f"the runtime's zone database does not know \"${timezone}\""))
    case _ -> null
  }
  let configuration = settings(
    standup_channel = standup_channel,
    facilitator_channel = env.get_or(key = "FACILITATOR_CHANNEL", fallback = standup_channel),
    standup_hour = standup_hour,
    timezone = timezone,
    window_minutes = window_minutes,
  )
  use anthropic.provider(
    source = credentials.env(key = "ANTHROPIC_API_KEY"),
    system = "You are a standup scribe. You draft digests from teammates' replies: faithful to what was written, compact, no invention — an entry you were not given does not exist.",
  )
  use slack.provider(
    bot_source = credentials.env(key = "SLACK_BOT_TOKEN"),
    app_source = credentials.env(key = "SLACK_APP_TOKEN"),
  )
  // The scribe desk: one sequential handler, so its `var` is an actor's state and collecting never
  // interleaves with opening or closing a window. The entries are run state; nothing rebuilds them.
  use handler (var window: window_state = idle()) {
    request channel_message(author: string, text: string, thread: string | null) {
      match (window) {
        case idle(_) -> { next null }
        case collecting(date => date, prompt_ts => prompt_ts, entries => entries) -> {
          match (thread) {
            // Only replies threaded under the day's prompt are entries.
            case null -> { next null }
            case reply_thread -> {
              if (reply_thread == prompt_ts) {
                next null with { window = collecting(date = date, prompt_ts = prompt_ts, entries = array.append(target = entries, value = entry(author = author, text = text))) }
              } else {
                next null
              }
            }
          }
        }
      }
    }
    request window_started(date: string, prompt_ts: string) {
      match (window) {
        case idle(_) -> { next null with { window = collecting(date = date, prompt_ts = prompt_ts, entries = []) } }
        // Opening a window while one is already open is what a restart produces: this desk is run state
        // and survives it, while the schedule fiber is run again and re-opens today's recorded window.
        case collecting(date => open_date, prompt_ts => open_ts, entries => entries) -> {
          if (open_date == date && open_ts == prompt_ts) {
            // The same window: keep what was collected, so a re-open never discards entries.
            next null
          } else {
            // A different window: replace, so one day's leftovers cannot leak into another's digest.
            next null with { window = collecting(date = date, prompt_ts = prompt_ts, entries = []) }
          }
        }
      }
    }
    request window_finished() {
      match (window) {
        case idle(_) -> { next [] }
        case collecting(date => _, prompt_ts => _, entries => entries) -> {
          next entries with { window = idle() }
        }
      }
    }
  }
  let nursery = use region.provide[scribe_scope, fiber_ceiling]
  // Each fiber supervises itself, so only a throw it could not keep escapes here, and none self-heal.
  use handler {
    request region.crashed(id: string, name: string, message: string) {
      next null
    }
    request region.failed(id: string, name: string, error: unknown) {
      prelude.throw(error = fiber_failure(name = name, detail = json.stringify(value = error)))
    }
  }
  let _watcher = region.fork(nursery = nursery, task = channel_watcher, argument = { channel = configuration.standup_channel }, name = "channel-watcher")
  let _schedule = region.fork(nursery = nursery, task = standup_schedule, argument = { configuration = configuration }, name = "standup-schedule")
  region.watch(nursery = nursery)
}
