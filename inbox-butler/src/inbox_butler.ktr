// inbox-butler: a quiet Gmail-to-Calendar secretary. A gmail source fiber reports each newly arrived
// mail to one sequential desk; the desk triages it with one structured model call; a mail that looks
// like a meeting becomes a gate fiber — an editable form on Discord — and only a submit creates it.

import ai
import ai.anthropic
import discord
import gmail
import google_calendar
import inbox_butler.triage

// The channel the butler asks in, and the clock a mail's "tomorrow 15:00" resolves against. Both are
// required and empty when unset; `main` refuses to start on a blank one.
agent butler_channel() {
  string.trim(value = env.get_or(key = "BUTLER_CHANNEL", fallback = ""))
}

agent butler_timezone() {
  string.trim(value = env.get_or(key = "BUTLER_TIMEZONE", fallback = ""))
}

// The optional env `GMAIL_POLL_MINUTES`, spelled once so `main` validates what the source polls on.
agent gmail_poll_minutes() {
  match (string.to_integer(value = string.trim(value = env.get_or(key = "GMAIL_POLL_MINUTES", fallback = "")))) {
    case null -> 5
    case minutes -> minutes
  }
}

// ── the interaction plane: one seam every human question goes through ─────────────────────────────

@"The question reached the operator and a control completed it."
data asked(@"Which control completed, and with what." answer: discord.answer)

@"NOBODY was asked — Discord refused the post, or the runtime restarted while the question stood; a value, because the gate that performed the ask cannot catch a throw raised above its own frame."
data not_asked(@"Why the question could not be posted, in one clause." reason: string)

// What performing `ask_operator` answers with. (Type synonyms take no docs.)
type ask_outcome = asked | not_asked

@"Ask the operator one question in the butler channel and BLOCK until they complete a control —
the seam every human decision goes through, so no gate has to know a channel."
request ask_operator(prompt: string, controls: array[discord.control]) -> ask_outcome

@"The ask adapter's body: post the question and answer with its own failure. A refused post and an
interrupted question both become `not_asked`; `auth_error` re-raises, so a dead token stops the butler."
agent guarded_ask(prompt: string, controls: array[discord.control]) -> ask_outcome {
  // Not `prelude.catch`: the ending this must fail closed on is the other one — a restart interrupts
  // the ask, which is a panic. Both converters fold the two endings into one handle to match on.
  match (supervise.once(task = agent () -> discord.answer {
    use supervise.signal_panics[discord.discord_error]()
    use supervise.signal_throws[discord.discord_error]()
    discord.ask(channel = butler_channel(), prompt = prompt, controls = controls)
  })) {
    case supervise.ran(value => answer) -> asked(answer = answer)
    case supervise.signalled(failure => why) -> {
      // Absorbed endings are named and the residual flies, so a constructor added later stops the run.
      match (why) {
        case discord.api_error(message => text) -> not_asked(reason = f"Discord refused the question (${text})")
        case supervise.panicked(message => msg) -> not_asked(reason = f"the question never reached the operator (${msg}); an interrupted call is never re-run, so nothing was approved")
        case rest -> prelude.throw(error = rest)
      }
    }
  }
}

@"The operator's decision, READ: create at @values@ — the form as submitted, not the proposal."
data granted(@"Every declared field's text as submitted." values: record[string])

@"The operator's decision, READ: nothing is created."
data refused(@"Why not, in one clause." reason: string)

// One gate's outcome, read from the answer once. (Type synonyms take no docs.)
type decision = granted | refused

// One submitted box, trimmed, or "" when blank or missing. The form ships the model's proposal as prefill, so an
// empty box was cleared on purpose — blank means blank.
agent kept_text(values: record[string], key: string) {
  match (record.get(target = values, key = key)) {
    case null -> ""
    case text -> string.trim(value = text)
  }
}

// The title is the event's substance: a submit that still holds one is `granted`, anything else not.
agent read_answer(answer: discord.answer) {
  match (answer) {
    case discord.submitted(id => _, values => values, by => _, display_name => _) -> {
      if (kept_text(values = values, key = "title") == "") {
        refused(reason = "the operator cleared the title — an emptied draft reads as 'do not create this'")
      } else {
        granted(values = values)
      }
    }
    case rest -> refused(reason = "the operator skipped it")
  }
}

// Post one line without letting a failed post kill the caller. A drop folds to null: this
// channel is the reporting surface, so the line has no second audience.
agent report(text: string) {
  let bounded = string.fit(value = text, cap = discord.limits().message_text, marker = "… (cut to fit one Discord message)")
  match (discord.try_send(channel = butler_channel(), text = bounded)) {
    case discord.delivered(_) -> null
    case discord.dropped(reason => _) -> null
  }
}

// ── the gate: fork, ask, one dispatch ─────────────────────────────────────────────────────────────

@"The session nursery's scope marker — one nullary phantom per nursery, per `region`'s rule."
effect butler_scope

// What a gate fiber may do: ask, then act. Its throws surface at the watch and end the run loudly.
type gate_ceiling = ask_operator | google_calendar.credential | discord.credential | io | prelude.throw[http.auth_error | discord.auth_error]

// What the mail source fiber may do; the store pair is the watch's durable cursor.
type source_ceiling = mail_arrived | gmail.credential | store.get | store.set | io

type bus_ceiling = gate_ceiling | source_ceiling

@"FORK a gate: run @task@ — one mail's whole question-and-consequence — as a fiber and answer AT ONCE, so the desk keeps triaging while the operator takes their time."
request spawn_gate(
  @"The gate's fiber name; prefixed `gate:` so a roster line reads as a pending question." name: string,
  @"The whole gate: ask the operator, then act on exactly what they answered — nullary, so the fork it becomes is applied to nothing." task: agent () -> null with gate_ceiling,
) -> null

@"Create the event exactly as the operator submitted it, answering the one line the channel gets: the
created link, or the typed failure. Fail-closed — any box this cannot read creates nothing and says why."
agent create_as_submitted(values: record[string], subject: string, note: string) {
  use handler {
    request prelude.throw(error: http.api_failure | http.fetch_error | json.parse_error) -> never {
      // Name what is absorbed, let the residual fly; naming buys a sentence instead of a JSON dump.
      let why = match (error) {
        case http.api_error(status => status, context => context, message => text) -> f"Google refused the call (${context}: ${string.to_string(value = status)} — ${text})"
        case http.fetch_error(message => text) -> f"the network dropped (${text})"
        case json.parse_error(message => text) -> f"Google's reply did not parse (${text})"
        case rest -> prelude.throw(error = rest)
      }
      break f"(creating the event FAILED: ${why}. The calendar was NOT changed — the mail is still in your inbox.)"
    }
  }
  let title = kept_text(values = values, key = "title")
  let start_text = kept_text(values = values, key = "start")
  let duration_text = kept_text(values = values, key = "duration")
  let location = kept_text(values = values, key = "location")
  match (time.from_rfc3339(value = start_text)) {
    case null -> f"(no event was created: the start box read \"${start_text}\", which is not an RFC3339 timestamp with an offset.)"
    case start_milliseconds -> {
      match (string.to_integer(value = duration_text)) {
        case null -> f"(no event was created: the duration box read \"${duration_text}\", which is not a whole number of minutes.)"
        case minutes -> {
          // The UTC arm names the same instant (`main` refused unresolvable zones): it respells, never moves.
          let offset = match (time.zone_offset(epoch_milliseconds = start_milliseconds, zone = butler_timezone())) {
            case null -> 0
            case resolved -> resolved
          }
          // The calendar package's event carries no location field, so the place rides the description.
          let location_line = if (location == "") { "" } else { f"Location: ${location}\n" }
          let created = google_calendar.create_event(
            calendar_id = env.get_or(key = "CALENDAR_ID", fallback = "primary"),
            summary = title,
            start = start_text,
            end = time.to_rfc3339(epoch_milliseconds = start_milliseconds + minutes * 60000, offset_minutes = offset),
            description = f"${location_line}Proposed by inbox-butler from the mail \"${subject}\". ${note}",
          )
          f"(created: ${created.summary} — ${created.start} → ${created.end} — ${created.html_link})"
        }
      }
    }
  }
}

@"One mail's gate, whole: put the prefilled draft in front of the operator, then act on exactly what
came back. A skip is quiet; an unpostable question is loud, because that silence would mean events
silently never offered."
agent event_gate(sender: string, subject: string, candidate: triage.event_candidate) {
  let location_note = if (string.trim(value = candidate.location) == "") { "" } else { f" at ${candidate.location}" }
  // The essentials lead and the model's prose trails: a cut never costs the decision its facts.
  let prompt = string.fit(
    value = f"Mail from ${sender} — \"${subject}\" looks like it wants a meeting: ${candidate.note}\nProposed: ${candidate.title} — ${candidate.start_rfc3339}, ${string.to_string(value = candidate.duration_minutes)} min${location_note}.\nOpen \"edit & create\" to fix any field before it lands, or skip.",
    cap = discord.limits().message_text,
    marker = "… (cut; the form holds the full values)",
  )
  let outcome = ask_operator(prompt = prompt, controls = [
    discord.form(id = "event", label = "edit & create", title = "calendar event", fields = [
      discord.field(id = "title", label = "title (blank = do not create)", value = candidate.title),
      discord.field(id = "start", label = "start (RFC3339, with offset)", value = candidate.start_rfc3339),
      discord.field(id = "duration", label = "duration (minutes)", value = string.to_string(value = candidate.duration_minutes)),
      discord.field(id = "location", label = "location (blank = none)", value = candidate.location),
    ]),
    discord.button(id = "skip", label = "skip"),
  ])
  match (outcome) {
    case not_asked(reason => reason) -> report(text = f"(could not ask about \"${subject}\": ${reason}. No event was created; the mail is still in your inbox.)")
    case asked(answer => answer) -> {
      match (read_answer(answer = answer)) {
        case refused(reason => _) -> null
        case granted(values => values) -> report(text = create_as_submitted(values = values, subject = subject, note = candidate.note))
      }
    }
  }
}

// ── the desk and its source ───────────────────────────────────────────────────────────────────────

@"Report one newly arrived mail to the desk — the source fiber's only voice."
request mail_arrived(message: gmail.message) -> null

@"The desk's body for one mail: dedup, triage, dispatch. `gmail.watch` delivers AT LEAST once, so a
durable marker keyed on the message id is set BEFORE the model call. The price is a mail whose triage
failed or was interrupted: reported once at most, never tried again, untouched in the inbox."
agent handle_mail(message: gmail.message) {
  match (store.get(key = f"inbox_butler/handled/${message.id}")) {
    case store.found(value => _) -> null
    case store.absent(key => _) -> {
      store.set(key = f"inbox_butler/handled/${message.id}", value = true)
      match (triage.triage_mail(message = message, zone = butler_timezone())) {
        // Not a meeting: no message at all — the butler is quiet by design.
        case triage.not_event() -> null
        case triage.triage_failed(reason => reason) -> report(text = f"(could not triage \"${message.subject}\" from ${message.sender}: ${reason}. It stays in your inbox and the butler will not try again — read it yourself.)")
        // The residual arm is exactly `event_candidate`. The gate is a fork, so the desk keeps
        // triaging while this question waits on a human.
        case candidate -> {
          agent decide() -> null with gate_ceiling {
            event_gate(sender = message.sender, subject = message.subject, candidate = candidate)
          }
          spawn_gate(name = f"gate:mail:${message.id}", task = decide)
        }
      }
    }
  }
}

@"The mail source's whole body: watch the mailbox and report each arrival. Poll failures — including
`http.auth_error`, since a re-run re-resolves the token and a credential needing a human PARKS on its
authorize escalation — become `supervise.interrupted`, and the durable cursor delivers the downtime."
agent mail_source() -> null with source_ceiling {
  // Only the first delay is stated: a mailbox that just refused a poll is rarely ready a second later.
  use supervise.forever(initial_delay_milliseconds = 5000.0)
  use handler {
    request prelude.throw(error: http.api_failure | http.fetch_error | json.parse_error) -> never {
      supervise.interrupted(failure = error)
    }
  }
  gmail.watch(
    query = env.get_or(key = "GMAIL_QUERY", fallback = "in:inbox"),
    poll_interval_milliseconds = gmail_poll_minutes() * 60000,
    cursor_at = poll.resume(key = "inbox_butler/gmail_cursor"),
    deliver_to = agent (value: gmail.message) { mail_arrived(message = value) },
  )
}

// ── the resident: one policy for failure ──────────────────────────────────────────────────────────

@"THE RESIDENT: install the providers and the handler stack in its load-bearing order, fork the mail
source, pump the region — forever. The ask adapter is first and PARALLEL, so several gates can wait at
once. Every throw this does not fold rides to `main`'s fatal sink and stops the run with one line."
agent session() -> never {
  use discord.provider(source = credentials.env(key = "DISCORD_TOKEN"))
  use anthropic.provider(source = credentials.env(key = "ANTHROPIC_API_KEY"))
  use gmail.provider(source = credentials.oauth(name = "google"))
  use google_calendar.provider(source = credentials.oauth(name = "google"))
  use parallel handler {
    request ask_operator(prompt: string, controls: array[discord.control]) {
      next guarded_ask(prompt = prompt, controls = controls)
    }
  }
  let nursery = use region.provide[butler_scope, bus_ceiling]
  use handler {
    request spawn_gate(name: string, task: agent () -> null with gate_ceiling) {
      let _handle = region.fork(nursery = nursery, task = task, argument = {}, name = name)
      next null
    }
  }
  // The source's name, spelled once: the fork tags by it and the crashed clause reads it back.
  let source_name = "source:gmail"
  // One sequential block, three clauses: the desk, and the two endings a fiber cannot report itself.
  use handler {
    request mail_arrived(message: gmail.message) {
      next handle_mail(message = message)
    }
    request region.crashed(id: string, name: string, message: string) {
      // Whose fiber was interrupted decides the answer. The source is the butler's hearing and a fresh
      // fork gets it back; a gate's panic is one lost question, and re-asking it would be worse.
      if (name == source_name) {
        report(text = f"(the mail watch stopped: ${message}. Starting it again — nothing that arrived meanwhile is skipped, the cursor is durable.)")
        let _replacement = region.fork(nursery = nursery, task = mail_source, argument = {}, name = source_name)
        next null
      } else {
        next report(text = f"(fiber ${name} crashed: ${message} — that question was not asked; its mail is still in your inbox. The butler keeps running.)")
      }
    }
    request region.failed(id: string, name: string, error: unknown) {
      // What nothing heals ends the run loudly; one errand's bad luck is one line, and the other
      // gates keep their questions.
      match (error) {
        case http.auth_error(status => _, context => _, message => _) -> prelude.throw(error = error)
        case discord.auth_error(message => _) -> prelude.throw(error = error)
        case env.missing_secret(key => _, message => _) -> prelude.throw(error = error)
        case rest -> { next report(text = f"(${name} failed: ${json.stringify(value = rest)}. That errand did not complete; the butler keeps running.)") }
      }
    }
  }
  let _source = region.fork(nursery = nursery, task = mail_source, argument = {}, name = source_name)
  region.watch(nursery = nursery)
}

@"The one-time liveness probe: `send_message` and not `try_send`, so a typo'd channel id or a rejected
token fails here as a console line instead of a swallowed drop on every later post."
agent boot_probe() -> string {
  use handler {
    request prelude.throw(error: unknown) -> never { break f"failed: could not post to BUTLER_CHANNEL — the token, the channel id or the bot's access to that channel is wrong (${json.stringify(value = error)}). Fix it and run again." }
  }
  use discord.provider(source = credentials.env(key = "DISCORD_TOKEN"))
  let _id = discord.send_message(channel = butler_channel(), text = f"(inbox-butler online — clock ${butler_timezone()})")
  ""
}

@"Entry: run the inbox butler as a resident, refusing to start on a missing channel, an unresolvable
timezone, a poll cadence under a minute or an unpostable channel — each as one console line.
Run: katari run inbox_butler.main --detach"
agent main() -> string {
  // A panic reaching here is a call interrupted on the resident's own path; a fiber's is `crashed`.
  use handler { request panic(msg: string) { break f"failed: ${msg}" } }
  use handler {
    request prelude.throw(error: unknown) -> never {
      break f"fatal: ${json.stringify(value = error)}"
    }
  }
  match (butler_channel()) {
    case "" -> { return "failed: the non-secret env BUTLER_CHANNEL must be set — `katari env set BUTLER_CHANNEL <channel id>` — and the bot must be able to post there." }
    case _configured -> null
  }
  match (time.zone_offset(epoch_milliseconds = time.now(), zone = butler_timezone())) {
    case null -> { return f"failed: BUTLER_TIMEZONE is \"${butler_timezone()}\", which the runtime cannot resolve. Set an IANA zone name — `katari env set BUTLER_TIMEZONE Asia/Tokyo` — and run again." }
    case _offset -> null
  }
  // A non-positive period panics `time.interval` in the mail source, and the crash policy forks it
  // straight back into the same panic — so a knob an operator types is refused here, not budgeted there.
  if (gmail_poll_minutes() < 1) {
    return f"failed: GMAIL_POLL_MINUTES is ${string.to_string(value = gmail_poll_minutes())}, and the mail watch needs at least one minute — `katari env set GMAIL_POLL_MINUTES 5` — then run again."
  } else {
    null
  }
  match (boot_probe()) {
    case "" -> null
    case failure -> { return failure }
  }
  session()
}
