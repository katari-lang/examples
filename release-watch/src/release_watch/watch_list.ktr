// The durable side of the monitor: one store cell holding every watch, keyed by the repository's own
// `owner/name`. One read is the whole list, and every write is a read-modify-write of that cell in
// the workspace's own lane, so two tools of one turn batch — or a tool and a poll tick — cannot lose
// each other's edit.

import release_watch.github

agent watches_key() {
  "watches"
}

// ── what one completed check amounted to ──────────────────────────────────────────────────────────

@"The watch is registered and no check has run yet."
data not_checked_yet()

@"The first successful check primed the cursor at the latest @tag@ (empty when there are no releases)
without announcing — a watch starts at now, never with the backlog."
data baseline_set(tag: string)

@"The check found nothing newer than the cursor (or still no releases at all)."
data no_new_release()

@"The check announced @tag@ and advanced the cursor to it."
data release_announced(tag: string)

@"A new release was found but the post dropped: the cursor did not advance and the next tick retries."
data announcement_dropped(tag: string, reason: string)

@"The check itself failed — the folded reason, so a listing shows a typo'd name or a rate limit."
data check_failed(reason: string)

// The last completed check of one repository, as a dispatchable fact. (Type synonyms take no docs.)
type check_outcome = not_checked_yet | baseline_set | no_new_release | release_announced | announcement_dropped | check_failed

// The cursor is a sum, not a string with sentinel readings: "never checked" and "checked, and there
// was nothing" must not blur, or a watch whose first check failed would announce the old backlog.

@"No successful check has happened yet, so nothing can be judged new."
data no_baseline()

@"The watch last stood at zero published releases, so any release that appears is new."
data nothing_released()

@"Releases up to @tag@ are old news; a different latest tag is new."
data announced_up_to(tag: string)

// Where one watch's announce cursor stands. (Type synonyms take no docs.)
type cursor = no_baseline | nothing_released | announced_up_to

@"One watch's durable state: its announce cursor and its last completed check, in one value — so a
tick commits both together and no reader can see them disagree."
data watch_state(cursor: cursor, outcome: check_outcome)

// The cell's shape: `owner/name` to that watch's state. (Type synonyms take no docs.)
type watch_table = record[watch_state]

@"One watch as a reader wants it: the repository its key names, and the state beside it."
data watch(repository: github.repository_spec, state: watch_state)

// What a watch starts at.
agent fresh_state() {
  watch_state(cursor = no_baseline(), outcome = not_checked_yet())
}

// ── the watch list ────────────────────────────────────────────────────────────────────────────────

@"Read a name into the spec the list keys on: exactly `owner/name`, both segments non-blank, trimmed
and lower-cased because GitHub itself is case-insensitive — or `null` when it is not two segments."
agent read_repository(text: string) {
  let segments = for (let part in string.split(value = text, separator = "/")) {
    next string.to_lower(value = string.trim(value = part))
  }
  match (array.get(target = segments, index = 0)) {
    case null -> null
    case owner -> {
      match (array.get(target = segments, index = 1)) {
        case null -> null
        case name -> {
          if (array.length(target = segments) == 2 && owner != "" && name != "") {
            github.repository_spec(owner = owner, name = name)
          } else {
            null
          }
        }
      }
    }
  }
}

// The one cell; an absent one, and one this version cannot read, are both an empty list.
agent read_table() {
  store.get_or[watch_table](key = watches_key(), fallback = {})
}

agent watch_exists(repository: github.repository_spec) {
  record.has(target = read_table(), key = github.render_repository(repository = repository))
}

@"Every watch, read fresh by each tick and by the listing tool — one cell read, so nothing assembles
the list out of parts that could disagree. A key this version cannot read is passed by."
agent read_watches() {
  array.flatten(target = for (let [key, state] in record.entries(target = read_table())) {
    next match (read_repository(text = key)) {
      case null -> []
      case repository -> [watch(repository = repository, state = state)]
    }
  })
}

agent save_watch(repository: github.repository_spec) {
  let key = github.render_repository(repository = repository)
  agent add() -> null {
    store.set(key = watches_key(), value = record.set(target = read_table(), key = key, value = fresh_state()))
  }
  let _done = store.exclusive(task = add)
  null
}

agent remove_watch(repository: github.repository_spec) {
  let key = github.render_repository(repository = repository)
  agent forget() -> null {
    store.set(key = watches_key(), value = record.remove(target = read_table(), key = key))
  }
  let _done = store.exclusive(task = forget)
  null
}

// `unwatch` deletes the entry, and a check that began before it must not write the watch back.
agent write_state(repository: github.repository_spec, state: watch_state) {
  let key = github.render_repository(repository = repository)
  agent commit() -> null {
    let table = read_table()
    match (record.get(target = table, key = key)) {
      case null -> null
      case _ -> store.set(key = watches_key(), value = record.set(target = table, key = key, value = state))
    }
  }
  let _done = store.exclusive(task = commit)
  null
}

// ── rendering one watch ───────────────────────────────────────────────────────────────────────────

@"One watch as a listing line, so a typo'd name's 404 is readable there rather than in logs."
agent render_row(row: watch) {
  f"${github.render_repository(repository = row.repository)} — ${render_state(state = row.state)}"
}

agent render_state(state: watch_state) {
  let standing = match (state.cursor) {
    case no_baseline(_) -> "no baseline yet"
    case nothing_released(_) -> "no releases published yet"
    case announced_up_to(tag => tag) -> f"cursor at ${tag}"
  }
  let outcome = match (state.outcome) {
    case not_checked_yet(_) -> "not checked yet"
    case baseline_set(tag => tag) -> if (tag == "") { "baseline set; the first release published from here is announced" } else { f"baseline set at ${tag}; announcing releases published after it" }
    case no_new_release(_) -> "ok, nothing new"
    case release_announced(tag => tag) -> f"announced ${tag}"
    case announcement_dropped(tag => tag, reason => reason) -> f"found ${tag} but the announcement was dropped (${reason}); retrying next tick"
    case check_failed(reason => reason) -> f"failed: ${reason}"
  }
  f"${standing}; last check: ${outcome}"
}
