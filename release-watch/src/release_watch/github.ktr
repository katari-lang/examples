// The GitHub side of the monitor: one public JSON endpoint, one TOTAL probe. No GitHub credential
// is used (public release feeds need none), so no failure on this path is a config error: every
// way a probe can fail folds into `probe_failed` and the poll loop carries it as a value — the
// outcome-as-value convention, with the next tick as the only retry policy.

import release_watch.commands
import web

@"One release, as this monitor cares about it — read out of GitHub's payload at the fetch
boundary, so nothing downstream touches raw JSON."
data github_release(
  @"The release's git tag — the durable identity the cursor stores." tag: string,
  @"The release's display name; the tag when the author left it blank." title: string,
  @"The release page URL — always announced, so a cut announcement still links to everything." url: string,
  @"The release notes body, possibly empty." notes: string,
)

@"The probe found the repository's latest release."
data latest_release(@"The latest release, per GitHub's newest-first ordering." release: github_release)

@"The repository is reachable but has published no releases yet."
data no_release_yet()

@"The probe failed; @reason@ is the one-line diagnosis `list` shows — a 404 for a typo'd name, a
rate limit, a network fault, an unparseable payload. A VALUE, because the loop must outlive it."
data probe_failed(@"Why the check failed, in one line." reason: string)

// What one poll of one repository can find. (Type synonyms take no docs.)
type probe = latest_release | no_release_yet | probe_failed

@"The repository's releases endpoint, newest first, one entry — public JSON, no authentication.
Segments are URL-encoded so an odd typed character becomes GitHub's own 404, not another request."
agent releases_url(repository: commands.repository_spec) -> string {
  f"https://api.github.com/repos/${string.url_encode(value = repository.owner)}/${string.url_encode(value = repository.name)}/releases?per_page=1"
}

@"One folded probe failure as the line `list` shows. The status is read, never re-derived. 403 is
worded as the rate limit because that is what an UNAUTHENTICATED GitHub poll's 403 is — there is no
credential on this path, so web's auth reading has no referent here."
agent describe_failure(error: http.api_error | http.auth_error | http.fetch_error | json.parse_error) -> string {
  match (error) {
    case http.api_error(status => status, context => _, message => _) -> {
      match (status) {
        case 404 -> "GitHub answered 404 — no such repository (check the owner/name spelling)"
        case other -> f"GitHub answered HTTP ${string.to_string(value = other)}"
      }
    }
    case http.auth_error(status => status, context => _, message => _) -> f"GitHub answered HTTP ${string.to_string(value = status)} — most likely the unauthenticated rate limit (60 requests an hour); it clears on its own"
    case http.fetch_error(message => message) -> f"the request never completed: ${message}"
    case json.parse_error(message => _) -> "GitHub's payload did not parse as JSON"
  }
}

@"THE total probe: one repository's latest release as a value, never a throw. `prelude.catch`
folds the transport's whole throw union into `probe_failed`."
agent probe_release(repository: commands.repository_spec) -> probe with io {
  agent fetch_latest(value: null) -> probe with io | prelude.throw[http.api_error | http.auth_error | http.fetch_error | json.parse_error] {
    // `fetch_page`'s default budget (16000 code points) can cut a long release body MID-DOCUMENT
    // and a cut document fails to parse, so the budget is raised far past any single release
    // payload; one that still overflows folds into `probe_failed` via the parse error, which is
    // the honest reading of a document we provably do not have whole.
    let body = web.fetch_page(url = releases_url(repository = repository), max_characters = 400000)
    match (json.element(target = json.parse(text = body), index = 0)) {
      case null -> no_release_yet()
      case entry -> {
        let tag = json.text_at(target = entry, key = "tag_name")
        if (string.is_blank(value = tag)) {
          // A 200 whose first entry carries no tag is not a release list; say so rather than guess.
          probe_failed(reason = "GitHub answered 200 but the payload does not look like a release list")
        } else {
          latest_release(release = github_release(
            tag = tag,
            title = json.text_at(target = entry, key = "name", fallback = tag),
            url = json.text_at(target = entry, key = "html_url"),
            notes = json.text_at(target = entry, key = "body"),
          ))
        }
      }
    }
  }
  prelude.catch(
    task = fetch_latest,
    recover = agent (error: http.api_error | http.auth_error | http.fetch_error | json.parse_error) -> probe with io {
      probe_failed(reason = describe_failure(error = error))
    },
  )
}
