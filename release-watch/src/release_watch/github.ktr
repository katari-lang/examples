// The GitHub side of the monitor: one public JSON endpoint, one total probe. No credential is used
// here, so every way a probe can fail folds into `probe_failed` and the next tick is the only retry.

import web

@"One GitHub repository, as the two path segments its releases API is addressed by."
data repository_spec(owner: string, name: string)

@"One release, read out of GitHub's payload at the fetch boundary: @tag@ is the durable identity the
cursor stores, @url@ is always announced, @title@ falls back to the tag, @notes@ may be empty."
data github_release(tag: string, title: string, url: string, notes: string)

@"The probe found the repository's latest release, per GitHub's newest-first ordering."
data latest_release(release: github_release)

@"The repository is reachable but has published no releases yet."
data no_release_yet()

@"The probe failed; @reason@ is the one-line diagnosis a listing shows (a 404, a rate limit, a
network fault, an unparseable payload)."
data probe_failed(reason: string)

// What one poll of one repository can find. (Type synonyms take no docs.)
type probe = latest_release | no_release_yet | probe_failed

agent render_repository(repository: repository_spec) {
  f"${repository.owner}/${repository.name}"
}

// Segments are URL-encoded, so an odd character becomes GitHub's own 404 rather than another request.
agent releases_url(repository: repository_spec) {
  f"https://api.github.com/repos/${string.url_encode(value = repository.owner)}/${string.url_encode(value = repository.name)}/releases?per_page=1"
}

// 403 is worded as the rate limit because that is what an unauthenticated GitHub poll's 403 is.
agent describe_failure(error: http.api_error | http.auth_error | http.fetch_error | json.parse_error) {
  match (error) {
    case http.api_error(status => status, context => _, message => _) -> {
      match (status) {
        case 404 -> "GitHub answered 404 — no such repository (check the owner/name spelling)"
        case other -> f"GitHub answered HTTP ${string.to_string(value = other)}"
      }
    }
    case http.auth_error(status => status, context => _, message => _) -> f"GitHub answered HTTP ${string.to_string(value = status)} — most likely the unauthenticated rate limit (60 requests an hour); it clears on its own"
    case http.fetch_error(message => message) -> f"the request never completed: ${message}"
    case json.parse_error(message => _) -> "GitHub's payload did not parse as JSON"
  }
}

@"One repository's latest release as a value, never a throw: the converter turns the transport's throw
union into the supervision signal and `supervise.once` hands it back, once."
agent probe_release(repository: repository_spec) -> probe with io {
  match (supervise.once(task = agent () -> probe {
    use supervise.signal_throws[http.api_error | http.auth_error | http.fetch_error | json.parse_error]()
    // A cut document fails to parse, so the budget is raised far past any single release payload.
    let body = web.fetch_page(url = releases_url(repository = repository), max_characters = 400000)
    match (json.element(target = json.parse(text = body), index = 0)) {
      case null -> no_release_yet()
      case entry -> {
        let tag = json.text(target = json.field(target = entry, key = "tag_name"))
        if (string.trim(value = tag) == "") {
          probe_failed(reason = "GitHub answered 200 but the payload does not look like a release list")
        } else {
          latest_release(release = github_release(
            tag = tag,
            title = json.text(target = json.field(target = entry, key = "name"), fallback = tag),
            url = json.text(target = json.field(target = entry, key = "html_url")),
            notes = json.text(target = json.field(target = entry, key = "body")),
          ))
        }
      }
    }
  })) {
    case supervise.ran(value => found) -> found
    case supervise.signalled(failure => error) -> probe_failed(reason = describe_failure(error = error))
  }
}
