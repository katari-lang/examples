// release-watch: a GitHub release monitor managed from Discord. Say `watch owner/name` in the
// control channel; a durable poll loop checks the public releases API and announces new releases
// back in that channel. The watch list survives restarts (it IS the store), and a repository that
// starts failing is reported by `list` without ever taking the monitor down. The shape: one region
// bus; one sequential CONTROL DESK; one CONTROL SOURCE fiber; one POLL fiber; the desired set in
// `fleet`; per-watch cursors in the store. See the README for the operator view.

import discord
import fleet
import release_watch.commands
import release_watch.github
import release_watch.watch_list

// ── the bus ───────────────────────────────────────────────────────────────────────────────────────

@"The control desk's inbox: one incoming channel message, delivered whole by the source fiber."
request control_message(@"The message, as Discord delivered it." message: discord.message) -> null

@"The region's scope marker: one nullary phantom per nursery."
effect monitor_scope

// The nursery's CEILING: everything any fiber of it may raise, which is what the nursery type and
// `region.watch` are written against. Each fiber declares only the part it actually performs, so the
// escalation report stays a true capability read. Throws are absent by the region's contract — an
// uncaught fiber throw arrives at the watch as the typed `region.failed` event instead.
type monitor_ceiling = control_message | store.shared | discord.credential | io

@"A fiber's THROW escaped every fold it had — a fault no fresh fork and no future tick heals (a
revoked token, a stored shape that stopped parsing), so it is re-raised to the fatal sink and the run
stops loudly. A fiber PANIC is a different ending: the crash policy forks the task again."
data fiber_died(@"The fiber's name." name: string, @"The thrown value, rendered." detail: string)

// ── the sources ───────────────────────────────────────────────────────────────────────────────────

@"The control source: serve the watch channel forever, reporting each incoming message to the
desk. The bot's own posts are not delivered, so replying cannot loop. Opening the gateway is the watch's
own job, so a Discord refusal is a throw from HERE and the region's `failed` policy stops the run on one."
agent control_source(input: string) -> never with control_message | discord.credential | io | prelude.throw[discord.discord_error] {
  agent deliver(value: discord.message) -> null with control_message {
    control_message(message = value)
  }
  discord.watch_messages(channel = input, deliver_to = deliver)
}

@"The poll loop — deliberately ONE fiber over the whole desired set rather than one fiber per
repository: a tick reads the CURRENT rows and checks each in turn, so `watch` / `unwatch` need no
fork/cancel reconcile (the next tick simply sees the new set) — good enough for a release feed,
where a poll is cheap and order is irrelevant. `time.watch`'s timer is durable (a restart re-arms
the persisted next occurrence); the interval is read once at start (`POLL_MINUTES`, default 10) and
clamped to at least a minute, since `time.interval` demands a positive period and a `0` in the env
would otherwise take the fiber down at its first breath."
agent poll_source(input: string) -> never with store.shared | discord.credential | io | prelude.throw[json.validation_error | discord.auth_error] {
  let interval_minutes = math.max(left = env.get_integer_or(key = "POLL_MINUTES", fallback = 10), right = 1)
  agent tick(time: number) -> null with store.shared | discord.credential | io | prelude.throw[json.validation_error | discord.auth_error] {
    let _checked = for (let row in watch_list.read_watches()) {
      next match (watch_list.validate_watch(value = row.spec)) {
        // An unreadable row is boot's to delete and `list`'s to show; a tick passes it by.
        case null -> null
        case repository -> check_repository(channel = input, name = row.name, repository = repository)
      }
    }
    null
  }
  time.watch(schedule = time.interval(milliseconds = interval_minutes * 60000), deliver_to = tick)
}

// ── one repository's check ────────────────────────────────────────────────────────────────────────

@"One release announcement, sized for Discord. The LINK RIDES ABOVE the notes, so `fit_message`'s
cut can only ever cost prose, never the pointer to the rest of it."
agent announcement(repository: commands.repository_spec, release: github.github_release) -> string {
  let notes = if (string.is_blank(value = release.notes)) { "" } else { f"\n\n${string.trim(value = release.notes)}" }
  discord.fit_message(
    text = f"New release on ${commands.render_repository(repository = repository)}: ${release.title} (${release.tag})\n${release.url}${notes}",
    marker = "\n… (release notes cut to fit one Discord message; the full notes are at the link above)",
  )
}

@"Check ONE repository and commit what happened — the ONE place a probe is judged against the
cursor. A first successful check primes the baseline silently (a watch starts at now, never with
the backlog); a release past the baseline is announced; a dropped announcement HOLDS the cursor so
the next tick retries it (no retry is baked in anywhere else). The announcement rides AHEAD of the
state write, so a crash in that seam re-announces once rather than losing a release: announcements
are at-least-once, as the README says."
agent check_repository(channel: string, name: string, repository: commands.repository_spec) -> null with store.shared | discord.credential | io | prelude.throw[json.validation_error | discord.auth_error] {
  let previous = match (watch_list.read_state(name = name)) {
    case null -> watch_list.no_baseline()
    case state -> state.cursor
  }
  agent commit(cursor: watch_list.cursor, outcome: watch_list.check_outcome) -> null with store.shared {
    watch_list.write_state(name = name, state = watch_list.watch_state(cursor = cursor, outcome = outcome))
  }
  agent announce(release: github.github_release) -> null with store.shared | discord.credential | io | prelude.throw[discord.auth_error] {
    match (discord.try_send(channel = channel, text = announcement(repository = repository, release = release))) {
      case discord.delivered(_) -> commit(cursor = watch_list.announced_up_to(tag = release.tag), outcome = watch_list.release_announced(tag = release.tag))
      case discord.dropped(reason => reason) -> commit(cursor = previous, outcome = watch_list.announcement_dropped(tag = release.tag, reason = reason))
    }
  }
  match (github.probe_release(repository = repository)) {
    case github.probe_failed(reason => reason) -> commit(cursor = previous, outcome = watch_list.check_failed(reason = reason))
    case github.no_release_yet(_) -> {
      match (previous) {
        case watch_list.no_baseline(_) -> commit(cursor = watch_list.nothing_released(), outcome = watch_list.baseline_set(tag = ""))
        case _ -> commit(cursor = previous, outcome = watch_list.no_new_release())
      }
    }
    case github.latest_release(release => release) -> {
      match (previous) {
        case watch_list.no_baseline(_) -> commit(cursor = watch_list.announced_up_to(tag = release.tag), outcome = watch_list.baseline_set(tag = release.tag))
        case watch_list.nothing_released(_) -> announce(release = release)
        case watch_list.announced_up_to(tag => tag) -> {
          if (tag == release.tag) { commit(cursor = previous, outcome = watch_list.no_new_release()) } else { announce(release = release) }
        }
      }
    }
  }
}

// ── the control desk's turn ───────────────────────────────────────────────────────────────────────

@"One desk turn: dispatch a parsed command and answer with the reply text. `watch` is a
check-then-register and `unwatch` a lookup-then-forget; both are sound WITHOUT a lock because the
desk is sequential — its FIFO is the duplicate guard."
agent serve_command(parsed: commands.command) -> string with store.shared | prelude.throw[json.validation_error] {
  match (parsed) {
    case commands.watch_requested(repository => repository) -> {
      let subject = commands.render_repository(repository = repository)
      match (watch_list.find_watch(repository = repository)) {
        case null -> {
          let name = watch_list.save_watch(repository = repository)
          f"Watching ${subject} as `${name}`. The first check sets the baseline: releases published from now on are announced here."
        }
        case name -> f"Already watching ${subject} as `${name}`."
      }
    }
    case commands.unwatch_requested(repository => repository) -> {
      let subject = commands.render_repository(repository = repository)
      match (watch_list.find_watch(repository = repository)) {
        case null -> f"Not watching ${subject} — `list` shows what is."
        case name -> {
          watch_list.remove_watch(name = name)
          f"Stopped watching ${subject} (`${name}`)."
        }
      }
    }
    case commands.list_requested(_) -> {
      let rows = watch_list.read_watches()
      if (array.length(target = rows) == 0) {
        "Watching nothing. `watch owner/name` starts one."
      } else {
        let lines = for (let row in rows) { next watch_list.render_row(row = row) }
        string.join(parts = lines, separator = "\n")
      }
    }
    case commands.help_requested(note => note) -> {
      if (string.is_blank(value = note)) { commands.help_text() } else { f"${note}\n${commands.help_text()}" }
    }
  }
}

// ── boot and entry ────────────────────────────────────────────────────────────────────────────────

@"Boot's probe and report in one post: the online line (watch count, rows dropped by the sweep)
sent with `send_message` — NOT `try_send`, so a typo'd channel id fails the boot loudly instead of
making every later announcement a silently-dropped post. Answers \"\" on a clean boot."
agent boot_probe(channel: string, swept: fleet.sweep_result[commands.repository_spec]) -> string with discord.credential | io {
  use handler {
    request prelude.throw(error: discord.discord_error) -> never {
      break f"failed: could not post to WATCH_CHANNEL — the channel id looks wrong or the bot lacks access there (${json.stringify(value = error)})."
    }
  }
  let dropped = if (array.length(target = swept.dropped) == 0) {
    ""
  } else {
    f"\nDropped unreadable watch rows on boot: ${string.join(parts = swept.dropped, separator = ", ")} — `watch` them again if they still matter."
  }
  let _posted = discord.send_message(channel = channel, text = f"(release-watch online — watching ${string.to_string(value = array.length(target = swept.kept))} repositories; `list` shows them)${dropped}")
  ""
}

@"Entry: run the release monitor. Boot refuses loudly on missing config, sweeps the durable watch
list (validate-or-drop), proves the channel is postable with one online line, then serves forever —
a runtime restart costs the interrupted call and nothing else, and the crash policy below forks the
dead watch again. Run it detached: `katari run release_watch.main --detach`."
agent main() -> string {
  // A panic that reaches HERE ends the run with one line: it is a call the runtime interrupted on this
  // desk's own path. A FIBER's panic never arrives here — it is `region.crashed` below, forked again.
  use handler { request panic(msg: string) { break f"failed: ${msg}" } }
  // The fatal sink. Anything still flying here — a missing or revoked Discord token, a stored shape
  // that stopped parsing — is a failure no fresh fork and no future tick heals, and a stopped run is
  // a fact somebody notices, where an absorbed fatal is a monitor that silently watches nothing.
  use handler {
    request prelude.throw(error: unknown) -> never { break f"fatal: ${json.stringify(value = error)}" }
  }
  let channel = string.trim(value = env.get_or(key = "WATCH_CHANNEL", fallback = ""))
  if (string.is_blank(value = channel)) {
    return "failed: the non-secret env WATCH_CHANNEL must be set — `katari env set WATCH_CHANNEL <channel id>`. Commands and announcements both live there."
  } else {
    null
  }
  // The provider connects NOTHING: it serves the bot token, resolved per call, and a call that needs
  // the gateway opens one for its own lifetime. So nothing here points into the sidecar's memory and
  // there is no session to supervise — token plus channel is a whole reference, from any process.
  use discord.provider(source = credentials.env(key = "DISCORD_TOKEN"))
  // The app's place and serial domain, then the shared place INSIDE it — that order is the
  // contract that lands `fleet`'s critical sections (name minting) in a real serial domain.
  use store.workspace(path = "release_watch")
  use store.share
  let swept = watch_list.sweep_watches()
  // The probe answers "" for a clean boot and a sentence otherwise. A sentinel string, deliberately,
  // where the cursor next door is a sum: this value is read ONCE, two lines from where it is made,
  // and never stored — so a sum would buy nothing the two arms below do not already say, and the
  // reasons a cursor must be a sum (a reader far away, a value that outlives the run) are all absent.
  match (boot_probe(channel = channel, swept = swept)) {
    case "" -> null
    case failure -> { return failure }
  }
  // THE CONTROL DESK: sequential on purpose even with no `var` — see `serve_command`. A dropped
  // reply is matched, not ignored: `dropped` means the one channel this desk can speak in refused
  // the post, so there is nowhere to re-report it — the operator's unanswered command is the
  // visible symptom, and retyping it is the retry.
  use handler {
    request control_message(message: discord.message) {
      // Every reply is bounded here, at the desk's one send site, so a long `list` is cut with a
      // marker instead of being refused whole by Discord's cap.
      let reply = discord.fit_message(
        text = serve_command(parsed = commands.parse_command(text = message.text)),
        marker = "\n… (cut to fit one Discord message)",
      )
      let _outcome = match (discord.try_send(channel = message.channel, text = reply)) {
        case discord.delivered(_) -> null
        case discord.dropped(reason => _) -> null
      }
      next null
    }
  }
  let nursery: region.nursery[monitor_scope, monitor_ceiling] = use region.provide[monitor_scope, monitor_ceiling]
  // The fiber names, spelled once: the forks tag by them and the crash policy reads them back to pick
  // which task to fork again (both take the same argument — the watch channel).
  let control_name = "control-source"
  let poll_name = "poll-loop"
  // The region's death policy, split by ENDING, because the two mean opposite things here. A fiber's
  // PANIC is almost always the runtime having restarted under it, interrupting whatever call was in
  // flight — so FORK THE TASK AGAIN: the replacement resolves the token afresh and its new call opens
  // the gateway, with nothing left over from the dead one. A fiber's escaped THROW is a fault no fresh
  // fork heals (a revoked token, a shape that stopped parsing): both fibers already fold every failure
  // they anticipate, so a throw that still arrives here rides to the fatal sink.
  use handler {
    request region.crashed(id: string, name: string, message: string) {
      let _replacement = if (name == poll_name) {
        region.fork(nursery = nursery, task = poll_source, argument = channel, name = poll_name)
      } else {
        region.fork(nursery = nursery, task = control_source, argument = channel, name = control_name)
      }
      next null
    }
    request region.failed(id: string, name: string, error: unknown) {
      prelude.throw(error = fiber_died(name = name, detail = json.stringify(value = error)))
    }
  }
  let _control = region.fork(nursery = nursery, task = control_source, argument = channel, name = control_name)
  let _poll = region.fork(nursery = nursery, task = poll_source, argument = channel, name = poll_name)
  region.watch(nursery = nursery)
}
