// release-watch: a GitHub release monitor with an AI front desk. One curator keeps the watch list
// from a Discord channel — `watch`, `unwatch`, `list_watches` are its whole tool set — while a poll
// fiber checks the watched repositories on a durable timer and announces releases itself.

import ai
import ai.anthropic
import discord
import release_watch.github
import release_watch.watch_list

// ── what this program's own agents may do ─────────────────────────────────────────────────────────

// The row every agent of ours runs under — the tools, the persona, the watcher, the reply — and the
// one type argument `ai.route` and `ai.spawn` take. (Type synonyms take no docs.)
type watch_effects =
  discord.credential
  | store.get | store.exclusive
  | io | prelude.throw[discord.discord_error | env.missing_secret | oauth.server_error]

@"A fiber's throw escaped every fold it had, or the curator or the poll fiber ended. No fresh fork
fixes either, so the run stops rather than leaving a monitor that watches nothing."
data fiber_died(@"The dead fiber's name tag." name: string, @"What ended it." detail: string)

// Everything the composition root anticipates stopping on. (Type synonyms take no docs.)
type app_error = ai.duplicate_tool | discord.discord_error | env.missing_secret | oauth.server_error | fiber_died

// ── configuration ─────────────────────────────────────────────────────────────────────────────────

@"The channel the curator serves and releases are announced in — the required env `WATCH_CHANNEL`."
agent watch_channel() {
  string.trim(value = env.get_or(key = "WATCH_CHANNEL", fallback = ""))
}

@"How often to check, in minutes — the optional env `POLL_MINUTES`, default 10. A value that is not
a whole number reads as unset, which is this program's judgement to make."
agent poll_minutes() {
  match (string.to_integer(value = string.trim(value = env.get_or(key = "POLL_MINUTES", fallback = "")))) {
    case null -> 10
    case minutes -> minutes
  }
}

// ── the curator: who it is, and the three things it can do ────────────────────────────────────────

@"The curator's character, an agent rather than a string because `ai.spawn` re-reads it every step."
agent curator_persona() -> string {
  "You keep the watch list of a GitHub release monitor, from this Discord channel. watch(repository) starts watching one, written owner/name; unwatch(repository) stops watching one; list_watches() shows every watch with where its announce cursor stands and what its last check found. Announcements are posted by the monitor itself on its own schedule: you neither post them nor learn when they go out, so never promise to announce something yourself and never claim a release was or was not published — list_watches is the whole of what you can see. Answer in one or two short lines, saying what the tool answered. Reply with empty text to stay silent when a message needs nothing from you."
}

@"Tool: start watching a GitHub repository for new releases. Only releases published from now on are
announced — the first check sets the baseline silently. Watching one already watched changes nothing."
agent watch(@"The repository, written owner/name, e.g. vercel/next.js." repository: string) -> string with store.get | store.exclusive {
  match (watch_list.read_repository(text = repository)) {
    case null -> f"\"${repository}\" is not a repository name — write it as owner/name, e.g. vercel/next.js."
    case found -> {
      let subject = github.render_repository(repository = found)
      if (watch_list.watch_exists(repository = found)) {
        f"Already watching ${subject}."
      } else {
        watch_list.save_watch(repository = found)
        f"Watching ${subject}. The first check sets the baseline: releases published from now on are announced here."
      }
    }
  }
}

@"Tool: stop watching a repository. Its cursor is forgotten with it, so watching it again starts from
a fresh baseline."
agent unwatch(@"The repository, written owner/name." repository: string) -> string with store.get | store.exclusive {
  match (watch_list.read_repository(text = repository)) {
    case null -> f"\"${repository}\" is not a repository name — write it as owner/name."
    case found -> {
      let subject = github.render_repository(repository = found)
      if (watch_list.watch_exists(repository = found)) {
        watch_list.remove_watch(repository = found)
        f"Stopped watching ${subject}."
      } else {
        f"Not watching ${subject} — list_watches shows what is."
      }
    }
  }
}

@"Tool: every watched repository, with where its announce cursor stands and what its last check found
— a failing check (a typo'd name, a rate limit) shows here as that watch's last outcome."
agent list_watches() -> string with store.get {
  let rows = watch_list.read_watches()
  if (array.length(target = rows) == 0) {
    "Watching nothing. `watch owner/name` starts one."
  } else {
    string.join(parts = for (let row in rows) { next watch_list.render_row(row = row) }, separator = "\n")
  }
}

// ── what the curator hears, and where it speaks ────────────────────────────────────────────────────

@"What the curator listens to: the watch channel, as its own source fiber; the bot's own posts are
not delivered, so a reply cannot loop. Opening the gateway is the watch's own job, so a Discord
refusal is a throw from here."
agent channel_watcher(self: string) -> null with ai.mail | discord.credential | io | prelude.throw[discord.discord_error] {
  use supervise.forever()
  use supervise.signal_panics[never]()
  discord.watch_messages(channel = watch_channel(), deliver_to = agent (value: discord.message) {
    let _posted = ai.mail(to = self, source = "watch-channel", content = value.text, hop = 0, files = value.files)
    null
  })
}

@"Where the curator speaks — the channel it is addressed from, so a dropped reply has nowhere better
to go and asking again is the retry."
agent post_reply(reply: string) {
  match (discord.try_send(channel = watch_channel(), text = string.fit(value = reply, cap = discord.limits().message_text, marker = "\n… (cut to fit one Discord message)"))) {
    case discord.delivered(_) -> null
    case discord.dropped(reason => _) -> null
  }
}

// ── the poll loop, where no model runs ────────────────────────────────────────────────────────────

@"One release announcement, sized for Discord: the link rides above the notes, so a cut costs prose
and never the pointer to the rest of it."
agent announcement(repository: github.repository_spec, release: github.github_release) {
  let notes = if (string.trim(value = release.notes) == "") { "" } else { f"\n\n${string.trim(value = release.notes)}" }
  string.fit(
    value = f"New release on ${github.render_repository(repository = repository)}: ${release.title} (${release.tag})\n${release.url}${notes}",
    cap = discord.limits().message_text,
    marker = "\n… (release notes cut to fit one Discord message; the full notes are at the link above)",
  )
}

@"Check one repository and commit what happened — the one place a probe is judged against the cursor.
A dropped announcement holds the cursor, and the post rides ahead of the state write, so a crash in
that seam re-announces once rather than losing a release: announcements are at-least-once."
agent check_repository(channel: string, row: watch_list.watch) {
  let previous = row.state.cursor
  agent commit(cursor: watch_list.cursor, outcome: watch_list.check_outcome) {
    watch_list.write_state(repository = row.repository, state = watch_list.watch_state(cursor = cursor, outcome = outcome))
  }
  agent announce(release: github.github_release) {
    match (discord.try_send(channel = channel, text = announcement(repository = row.repository, release = release))) {
      case discord.delivered(_) -> commit(cursor = watch_list.announced_up_to(tag = release.tag), outcome = watch_list.release_announced(tag = release.tag))
      case discord.dropped(reason => reason) -> commit(cursor = previous, outcome = watch_list.announcement_dropped(tag = release.tag, reason = reason))
    }
  }
  match (github.probe_release(repository = row.repository)) {
    case github.probe_failed(reason => reason) -> commit(cursor = previous, outcome = watch_list.check_failed(reason = reason))
    case github.no_release_yet(_) -> {
      match (previous) {
        case watch_list.no_baseline(_) -> commit(cursor = watch_list.nothing_released(), outcome = watch_list.baseline_set(tag = ""))
        case _ -> commit(cursor = previous, outcome = watch_list.no_new_release())
      }
    }
    case github.latest_release(release => release) -> {
      match (previous) {
        case watch_list.no_baseline(_) -> commit(cursor = watch_list.announced_up_to(tag = release.tag), outcome = watch_list.baseline_set(tag = release.tag))
        case watch_list.nothing_released(_) -> announce(release = release)
        case watch_list.announced_up_to(tag => tag) -> {
          if (tag == release.tag) { commit(cursor = previous, outcome = watch_list.no_new_release()) } else { announce(release = release) }
        }
      }
    }
  }
}

@"The poll loop — one fiber over the whole watch list rather than one per repository: a tick reads
the current keys and checks each in turn, so `watch` and `unwatch` need no fork/cancel reconcile. The
interval is clamped to at least a minute, since `time.interval` demands a positive period."
agent poll_source() -> never with store.get | store.exclusive | discord.credential | io | prelude.throw[discord.auth_error] {
  use supervise.forever()
  use supervise.signal_panics[never]()
  let channel = watch_channel()
  let interval_minutes = math.max(left = poll_minutes(), right = 1)
  agent tick(time: number) {
    let _checked = for (let row in watch_list.read_watches()) {
      next check_repository(channel = channel, row = row)
    }
    null
  }
  time.watch(schedule = time.interval(milliseconds = interval_minutes * 60000), deliver_to = tick)
}

// ── boot and entry ────────────────────────────────────────────────────────────────────────────────

@"Boot's one post, sent with `send_message` rather than `try_send`, so a typo'd channel id fails the
boot instead of making every later announcement a silently dropped post. Answers \"\" on a clean boot."
agent boot_probe(channel: string) {
  use handler {
    request prelude.throw(error: discord.discord_error) -> never {
      break f"failed: could not post to WATCH_CHANNEL — the channel id looks wrong or the bot lacks access there (${json.stringify(value = error)})."
    }
  }
  let _posted = discord.send_message(channel = channel, text = "(release-watch online — say `watch owner/name` here to add a repository)")
  ""
}

@"Entry: run the release monitor. Boot refuses loudly on missing config, proves the channel is
postable with one online line, then serves forever: `katari run release_watch.main --detach`."
agent main() -> string {
  use handler { request panic(msg: string) { break f"failed: ${msg}" } }
  // The fatal sink: a revoked token answers the same however often it is retried, so the run stops.
  use handler {
    request prelude.throw(error: app_error) -> never { break f"fatal: ${json.stringify(value = error)}" }
  }
  let channel = watch_channel()
  if (channel == "") {
    return "failed: the non-secret env WATCH_CHANNEL must be set — `katari env set WATCH_CHANNEL <channel id>`. The curator listens there and releases are announced there."
  } else {
    null
  }
  use discord.provider(source = credentials.env(key = "DISCORD_TOKEN"))
  use anthropic.provider(source = credentials.env(key = "ANTHROPIC_API_KEY"))
  // One workspace: the tools and the poll fiber resolve to the same `release_watch/watches/…`.
  use store.workspace(path = "release_watch")
  match (boot_probe(channel = channel)) {
    case "" -> null
    case failure -> { return failure }
  }
  // The curator and the poll fiber are the run, and a restart would have to stand at the altitude of
  // what died — inside the route, where this program deliberately puts none. Everything else is one
  // errand.
  use handler {
    request region.crashed(id: string, name: string, message: string) {
      if (name == "curator" || name == "poller") {
        prelude.throw(error = fiber_died(name = name, detail = f"it was interrupted mid-step (${message})"))
      } else {
        next null
      }
    }
    request region.failed(id: string, name: string, error: unknown) {
      prelude.throw(error = fiber_died(name = name, detail = json.stringify(value = error)))
    }
  }
  let root = use ai.route[watch_effects]()
  let _curator = ai.spawn[watch_effects](
    name = "curator",
    tools = [watch, unwatch, list_watches],
    max_steps = 8,
    persona = curator_persona,
    deliver_to = post_reply,
    sources = [channel_watcher],
  )
  let _poller = region.fork(nursery = root, task = poll_source, argument = {}, name = "poller")
  region.watch(nursery = root)
}
