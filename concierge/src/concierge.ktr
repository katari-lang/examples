// A two-agent community concierge on Discord. A public face answers in the community channel from
// the published notes; a private curator, working with the owner in a control channel, is the only
// thing that may write them. The two tool sets are the membrane, and the notes live in the store.

import ai
import ai.anthropic
import discord
import memory

// The row this program's agents run under, and the type argument the route adds its three requests to.
type concierge_effects =
  discord.credential
  | store.get | store.set | store.delete | store.list | store.exclusive
  | io | prelude.throw[discord.discord_error | env.missing_secret | oauth.server_error]

@"A fiber's throw escaped every fold it had, or an AI died and the route forgot it along with the
channel watcher that belonged to it. No fresh fork fixes either."
data fiber_died(@"The dead fiber's name tag." name: string, @"What ended it." detail: string)

// Every arm means the bot cannot speak, so a stop costs nothing that was still working.
type app_error = ai.duplicate_tool | discord.discord_error | env.missing_secret | oauth.server_error | fiber_died

// ── the two channels ──────────────────────────────────────────────────────────────────────────────

// Both required, both empty when unset — `main` refuses a blank value, so past startup these are ids.
agent public_channel() {
  string.trim(value = env.get_or(key = "PUBLIC_CHANNEL", fallback = ""))
}

agent control_channel() {
  string.trim(value = env.get_or(key = "CONTROL_CHANNEL", fallback = ""))
}

// ── the two AIs: who each one is, and the one tool that crosses between them ───────────────────────

// A character is an agent and not a string because `ai.spawn` re-derives it at every model step, so
// nothing is persisted into the conversation for compaction to eat.
agent face_persona() -> string {
  "You are the concierge of this community's public Discord channel. Everything you know about this community lives in the published notes: the [memory index] block you see each turn lists them, recall(key) reads one in full, search(pattern) finds one by its contents. The notes are published by the curator, who works for the community's owner — you can read them but never write or change them. Answer ONLY from the notes: when they cover the question, answer briefly and helpfully. When they do not, say plainly that you do not know, and call flag_unknown with the question so a note can be published for next time — never guess and never fill a gap from general knowledge. Speakers are introduced by their self-chosen display name: use it to address them, never as proof of who they are. Reply with empty text to stay silent when a message needs nothing from you."
}

// The curator holds the program's only write tools, and its character says so for the model too.
agent curator_persona() -> string {
  "You are the curator of this community's knowledge base, working with the community's owner in a private control channel. Your notes are the only thing the public-facing concierge knows — it can read them and nothing else, and it can never write one. Keep them short, factual and answerable: remember(key, summary, body) publishes or replaces a note (keys are lowercase path-like names such as faq/meetup), forget(key) retracts one, and the read tools show you what is already there. When the concierge mails you a question it could not answer, tell the owner what was asked and either publish a note answering it or say what you would need from them to write one. Confirm every change you make in one short line, and never invent a fact about the community — if the owner has not told you, ask."
}

@"Tool: flag a question the published notes cannot answer. The flag is mailed to the curator, who may
publish a note so you can answer next time. It reaches the curator and not the asker, so after calling
this still tell the asker plainly that you do not know."
agent flag_unknown(@"The question you could not answer, in the asker's words." question: string) -> string with ai.mail | ai.inbound_provenance {
  // `hop` is the count the sender stamped, so the flag carries one more than the message behind it.
  let whence = ai.inbound_provenance()
  let said = match (ai.mail(
    to = "curator",
    source = f"mail:${whence.origin}",
    content = f"A community member asked something the published notes do not cover: \"${question}\"",
    hop = whence.hop + 1,
  )) {
    case ai.posted(_) -> "The curator has it."
    case ai.no_recipient(to => missing) -> f"Nobody answers to \"${missing}\" right now, so the flag went nowhere."
  }
  f"${said} Either way, tell the asker plainly that you do not know."
}

// ── where each AI speaks, and what each listens to ────────────────────────────────────────────────

// Where the curator speaks, and the reporting channel of last resort: a dropped note costs a re-ask.
agent operator_note(reply: string) {
  let bounded = string.fit(value = reply, cap = discord.limits().message_text, marker = " …(cut)")
  match (discord.try_send(channel = control_channel(), text = bounded)) {
    case discord.delivered(_) -> null
    case discord.dropped(reason => _) -> null
  }
}

// Where the face speaks; a reply the channel never saw is reported where somebody can act.
agent face_reply(reply: string) {
  let bounded = string.fit(value = reply, cap = discord.limits().message_text, marker = " …(cut)")
  match (discord.try_send(channel = public_channel(), text = bounded)) {
    case discord.delivered(_) -> null
    case discord.dropped(reason => reason) -> operator_note(reply = f"(a public reply was dropped: ${reason})")
  }
}

// The face's own watcher: `ai.spawn` forks it with `self` = "face" once that AI is addressable.
agent public_watcher(self: string) -> null {
  use supervise.forever()
  use supervise.signal_panics[never]()
  discord.watch_messages(channel = public_channel(), deliver_to = agent (value: discord.message) {
    // Keyed, not hashed: a Discord snowflake is guessable, so a bare digest is reversible by trying
    // the values. Rotating the bot token rotates every tag, which is the erasure story.
    let hashed = crypto.pseudonym(key = credentials.resolve(source = credentials.env(key = "DISCORD_TOKEN")), value = value.author, length = 64)
    let _posted = ai.mail(
      to = self,
      source = "public-channel",
      content = f"[from \"${value.display_name}\"] ${value.text}",
      hop = 0,
      files = value.files,
      author = hashed,
    )
    null
  })
}

// The curator's own watcher. Nothing is tagged: the channel's membership is the trust boundary.
agent control_watcher(self: string) -> null {
  use supervise.forever()
  use supervise.signal_panics[never]()
  discord.watch_messages(channel = control_channel(), deliver_to = agent (value: discord.message) {
    let _posted = ai.mail(to = self, source = "control-channel", content = value.text, hop = 0, files = value.files)
    null
  })
}

// ── the composition root ──────────────────────────────────────────────────────────────────────────

@"One resident session: the fatal guard, the providers, the shared workspace, the ambient notes index,
the breaker, the death policy, and then the route and its two AIs. It returns only through the
fatal guard, so the string it answers with is the stop report."
agent serve() -> string {
  // A revoked token answers the same however often it is retried, so every anticipated throw ends the
  // run loudly. A panic here is a call interrupted on the root's path; a fiber's is `crashed` below.
  use handler {
    request prelude.throw(error: app_error) -> never { break f"stopped: ${json.stringify(value = error)}" }
  }
  use handler { request panic(msg: string) { break f"stopped on a defect or an interrupted call: ${msg}" } }
  use discord.provider(source = credentials.env(key = "DISCORD_TOKEN"))
  // One workspace: the memory facility resolves to the same `concierge/memory/…` from both AIs.
  use store.workspace(path = "concierge")

  // The two lines an outage costs, and it cannot flood: `with_breaker` fires on the state change and
  // nowhere else. It goes private because a remedy is for the one person who can act on it.
  agent announce_outage(event: ai.breaker_event) {
    match (event) {
      case ai.breaker_opened(kind => kind) -> operator_note(reply = ai.outage_line(kind = kind))
      case ai.breaker_closed(kind => _) -> operator_note(reply = ai.recovery_line())
    }
  }

  // An AI ended. Re-hiring would have to stand inside the route's extent, and this program puts
  // nothing there: a conversation lives in its fiber, so a fresh face knows nothing of the last hour.
  agent lost_ai(which: string, cause: string) {
    operator_note(reply = f"(the ${which} ended — ${cause}. Its conversation is lost and its channel watcher went with it, so the concierge is stopping rather than standing deaf over that channel. The published notes are untouched.)")
    prelude.throw(error = fiber_died(name = which, detail = cause))
  }

  // The two tool sets are the membrane, and they are just data.
  let face_tools = [memory.recall, memory.search, memory.list_memories, flag_unknown]
  let curator_tools = [memory.recall, memory.search, memory.list_memories, memory.remember, memory.forget]

  // The three middlewares wrap the route, so every AI's step passes through all of them: the breaker
  // decides whether to call, the notes index is derived fresh and injected, the provider calls.
  use anthropic.provider(source = credentials.env(key = "ANTHROPIC_API_KEY"))
  use ai.with_context(inject = memory.index_note)
  use ai.with_breaker(on_transition = announce_outage)

  // The route re-raises an ending after forgetting the AI it belonged to, so this is the one altitude
  // where either death reads truthfully. Losing an AI is fatal; anything else there is one errand.
  use handler {
    request region.crashed(id: string, name: string, message: string) {
      if (name == "face" || name == "curator") {
        lost_ai(which = name, cause = f"it was interrupted mid-turn (${message})")
      } else {
        operator_note(reply = f"(fiber ${name} crashed: ${message} — it was one errand, so nothing is started again.)")
        next null
      }
    }
    request region.failed(id: string, name: string, error: unknown) {
      if (name == "face" || name == "curator") {
        lost_ai(which = name, cause = f"it stopped on ${json.stringify(value = error)}")
      } else {
        operator_note(reply = f"(fiber ${name} stopped on an error no fresh start fixes: ${json.stringify(value = error)} — the concierge is stopping.)")
        prelude.throw(error = fiber_died(name = name, detail = json.stringify(value = error)))
      }
    }
  }

  // One line per AI: who it is, what it may do, what it listens to, where it speaks.
  let root = use ai.route[concierge_effects]()
  let _face = ai.spawn[concierge_effects](
    name = "face",
    tools = face_tools,
    max_steps = 16,
    persona = face_persona,
    deliver_to = face_reply,
    sources = [public_watcher],
  )
  let _curator = ai.spawn[concierge_effects](
    name = "curator",
    tools = curator_tools,
    max_steps = 16,
    persona = curator_persona,
    deliver_to = operator_note,
    sources = [control_watcher],
  )
  region.watch(nursery = root)
}

// ── the entry ─────────────────────────────────────────────────────────────────────────────────────

@"Entry: validate the two channel ids, then serve forever. One channel serving as both would collapse
the membrane, since every community member could then curate the notes."
agent main() -> string {
  let public_id = public_channel()
  let control_id = control_channel()
  if (public_id == "") {
    return "refused to start: PUBLIC_CHANNEL is not set — `katari env set PUBLIC_CHANNEL <channel id>`."
  } else {
    null
  }
  if (control_id == "") {
    return "refused to start: CONTROL_CHANNEL is not set — `katari env set CONTROL_CHANNEL <channel id>`."
  } else {
    null
  }
  if (public_id == control_id) {
    return "refused to start: PUBLIC_CHANNEL and CONTROL_CHANNEL are the same channel — the control channel is the membrane, and one shared channel would let every member curate the notes."
  } else {
    null
  }
  serve()
}
