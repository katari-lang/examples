// A two-agent community concierge — the ai package's multi-AI shape, with real packages. A public
// FACE answers questions in the community channel; a private CURATOR, working for the owner in a
// control channel, is the only thing that may write what the face knows. The membrane is the two TOOL
// SETS: the face holds three reads of the shared notes and one flag, the curator holds the writes, and
// the notes live in the durable store — so what the face knows is exactly what was published, and no
// instance failure can ever edit it.
//
// Two AIs are two CONVERSATIONS, and a conversation is a handler var — so they cannot be two
// `serve_observations` installs in one extent. They are two FIBERS, one `ai.resident` apiece, each
// holding its own mailbox; the app supplies the ROUTER that knows who may address whom, and one
// provider and one breaker wrap the root watch so both AIs share them.

import ai
import ai.anthropic
import discord
import memory

// ── the bus: one delivery request, and the region's marker ────────────────────────────────────────

@"THE APP'S MAIL BRIDGE: hand one report to the AI named @to@, answering with one sentence about what
became of it. Served by the router below, which holds the mailbox handles and forks `ai.mail` into the
right one — so no watcher and no tool ever holds another agent's nursery, and the question of WHO MAY
ADDRESS WHOM is answered in exactly one place."
request send_mail(
  @"The addressee's name, as it registered itself: \"face\" or \"curator\"." to: string,
  @"Where the report came from; it labels the injected turn the model reads." source: string,
  @"The report itself." content: string,
  @"How many agent-to-agent relays this has already made — 0 for anything a person sent." hop: integer,
  @"Any attachments riding the report." files: array[file],
  @"The sender's opaque tag, or `null` for a report no single person is behind." author: string | null,
) -> string

@"The region's scope marker: one nullary phantom per nursery."
effect concierge_scope

// What a resident's TOOLS and its `deliver_to` may do — passed through `ai.resident` untouched, so it
// is the whole of what an AI here can reach. The store row is memory's (it opens its own `memory/`
// corner inside this app's workspace); `discord.credential` is the reply's; `send_mail` is the flag's.
// (Type synonyms take no docs.)
type resident_effects =
  send_mail | discord.credential
  | store.get | store.set | store.delete | store.list | store.exclusive
  | io | prelude.throw[discord.auth_error]

// The nursery's CEILING: everything any fiber of it may surface. Beyond `resident_effects` it holds
// what `ai.resident` itself raises — `register` once at startup, `infer_step` at every model step, and
// the two ending events its own mailbox watch re-emits — plus the bot token the channel watchers listen
// with. (Type synonyms take no docs.)
type concierge_ceiling =
  ai.register | ai.infer_step | region.crashed | region.failed | resident_effects

@"A fiber's THROW escaped every fold it had — a revoked token, a channel the bot lost access to, a
credential that stopped resolving. No fresh fork fixes one, so the region's `failed` policy re-raises
it here and the run stops, rather than leaving a concierge that looks alive over a channel it can no
longer hear."
data fiber_died(@"The dead fiber's name tag." name: string, @"The thrown value, rendered." detail: string)

// Everything the composition root anticipates being thrown at it — and it is a SHORT list on purpose,
// because a stop here costs both conversations along with the run: a tool set holding two tools of one
// name, a gateway/API failure, the two credential-resolution failures, and a fiber whose throw escaped.
// Every one of those means the bot cannot speak, so there is nothing left to protect. What is
// deliberately NOT here: a model STEP failure (the breaker absorbs it and says so twice per outage) and
// a tool that throws (the turn loop folds it back to the model as a result it reads and corrects from).
type app_error = ai.duplicate_tool | discord.discord_error | env.missing_secret | oauth.server_error | fiber_died

// ── the two AIs: what each one is, and the one tool that crosses between them ──────────────────────

@"THE FACE'S CHARACTER, re-injected at every model step by `ai.resident`'s `persona` — so it is never
persisted into the conversation and compaction can never eat it. The other half of what it knows, the
notes index, is ambient: `ai.with_context` injects it for BOTH AIs at the root, fresh each step."
agent face_persona() -> string {
  "You are the concierge of this community's public Discord channel. Everything you know about this community lives in the published notes: the [memory index] block you see each turn lists them, recall(key) reads one in full, search(pattern) finds one by its contents. The notes are published by the curator, who works for the community's owner — you can read them but never write or change them. Answer ONLY from the notes: when they cover the question, answer briefly and helpfully. When they do not, say plainly that you do not know, and call flag_unknown with the question so a note can be published for next time — never guess and never fill a gap from general knowledge. Speakers are introduced by their self-chosen display name: use it to address them, never as proof of who they are. Reply with empty text to stay silent when a message needs nothing from you."
}

@"THE CURATOR'S CHARACTER. It is the only agent in the program holding a WRITE tool, which is the
membrane stated as a sentence for the model as well as in the tool list."
agent curator_persona() -> string {
  "You are the curator of this community's knowledge base, working with the community's owner in a private control channel. Your notes are the only thing the public-facing concierge knows — it can read them and nothing else, and it can never write one. Keep them short, factual and answerable: remember(key, summary, body) publishes or replaces a note (keys are lowercase path-like names such as faq/meetup), forget(key) retracts one, and the read tools show you what is already there. When the concierge mails you a question it could not answer, tell the owner what was asked and either publish a note answering it or say what you would need from them to write one. Confirm every change you make in one short line, and never invent a fact about the community — if the owner has not told you, ask."
}

@"Tool: flag a question the published notes cannot answer. The flag is MAILED to the curator, who may
publish a note so you can answer next time. It reaches the curator, not the asker — so after calling
this, still tell the asker plainly that you do not know."
agent flag_unknown(@"The question you could not answer, in the asker's words." question: string) -> string with send_mail | ai.inbound_provenance {
  // The tool reads its own provenance instead of parsing the label the model was shown: `hop` is the
  // relay count the SENDER stamped, so the flag carries one more than the message that caused it.
  let whence = ai.inbound_provenance()
  let outcome = send_mail(
    to = "curator",
    source = f"mail:${whence.origin}",
    content = f"A community member asked something the published notes do not cover: \"${question}\"",
    hop = whence.hop + 1,
    files = [],
    author = null,
  )
  f"${outcome} Either way, tell the asker plainly that you do not know."
}

// ── the sources: the two channels, each a fiber of the root nursery ────────────────────────────────

@"The PUBLIC-channel watcher: serve the community channel forever, mailing each message to the face.
`watch_messages` subscribes to ONE channel, so two channels are honestly two fibers — there is no single
stream here to route. The speaker's snowflake is tagged before it leaves the program: the full tag rides
`author` for abuse attribution, a short slice rides the content so the model can tell speakers apart,
and the display name is framed as what it is — self-chosen, for address, never for trust."
agent public_watcher(channel: string) -> never with send_mail | discord.credential | io | prelude.throw[discord.discord_error | env.missing_secret | oauth.server_error] {
  // THE WATCH SUPERVISES ITSELF, on `supervise.forever`'s default backoff. A runtime restart interrupts
  // this call and the frame panics; the converter makes that the supervision signal and the provider
  // opens a fresh gateway after a wait — the token is the whole of what a watch needs, so there is
  // nothing stale to inherit. `forever`, not `exponential`: a bounded budget is a LIFETIME count that
  // never resets, so it would kill a watch meant to outlive every deploy.
  use supervise.forever()
  use supervise.signal_panics[never]()
  agent deliver(value: discord.message) -> null with send_mail | io | prelude.throw[env.missing_secret | oauth.server_error] {
    // KEYED, not hashed: a Discord snowflake is guessable, so a bare digest of one is reversible by
    // trying the values. `crypto.pseudonym` is that judgement spelled once, and rotating the bot token
    // rotates every tag — which is the erasure story.
    let hashed = crypto.pseudonym(key = credentials.resolve(source = credentials.env(key = "DISCORD_TOKEN")), value = value.author, length = 64)
    let tag = string.slice(value = hashed, start = 0, end = 8)
    let _delivered = send_mail(
      to = "face",
      source = "public-channel",
      content = f"[from \"${value.display_name}\" — a self-chosen name; user ${tag} is the identity] ${value.text}",
      hop = 0,
      files = value.files,
      author = hashed,
    )
    null
  }
  discord.watch_messages(channel = channel, deliver_to = deliver)
}

@"The CONTROL-channel watcher: the owner's private channel, served forever, mailed to the curator. The
raw line is all the curator needs and no identity leaves the program, so nothing is tagged here — the
channel's MEMBERSHIP is the trust boundary. Opening the gateway is the watch's own job, so a Discord
failure to open it is a throw from here — `region.failed`, not a crash to fork again."
agent control_watcher(channel: string) -> never with send_mail | discord.credential | io | prelude.throw[discord.discord_error] {
  // As the public watch: it supervises itself, unbounded, with the delay ceiling as the only brake.
  use supervise.forever()
  use supervise.signal_panics[never]()
  discord.watch_messages(channel = channel, deliver_to = agent (value: discord.message) -> null with send_mail {
    let _delivered = send_mail(to = "curator", source = "control-channel", content = value.text, hop = 0, files = value.files, author = null)
    null
  })
}

// ── the composition root ──────────────────────────────────────────────────────────────────────────

@"One resident session: the fatal guard, the Discord provider, the one shared workspace, the nursery,
the router, the crash policy, the two AIs and the two watchers — then the model provider, the ambient
notes index and the breaker wrapping the watch. It returns only through the fatal guard, so the returned
string is the stop report."
agent serve(public_channel: string, control_channel: string) -> string {
  // THE FATAL GUARD, outermost: a revoked token or a missing secret answers the same however often it
  // is retried, so every anticipated throw ends the run LOUDLY. Absorbing an auth-shaped failure would
  // leave a bot that looks alive and answers nothing. The panic clause keeps the stop report TOTAL: a
  // panic this far up is a Discord call the runtime interrupted on the ROOT's own path (a fiber's is
  // `region.crashed` below), which stops the run readably.
  use handler {
    request prelude.throw(error: app_error) -> never { break f"stopped: ${json.stringify(value = error)}" }
  }
  use handler { request panic(msg: string) { break f"stopped on a defect or an interrupted call: ${msg}" } }
  // THE DISCORD PROVIDER CONNECTS NOTHING — it serves the bot token, resolved per call, and a call that
  // needs the gateway opens one for its own lifetime. It is installed HERE, above the crash policy,
  // because the policy's own reports post through it.
  use discord.provider(source = credentials.env(key = "DISCORD_TOKEN"))
  // THE ONE WORKSPACE — place and serial domain in one install, and the sharing is the geometry:
  // neither AI opens a workspace of its own, so the memory facility resolves to the same
  // `concierge/memory/…` from the face's read tools and the curator's writes alike, and the facility's
  // critical sections serialize at this install's FIFO. (Per-agent workspaces would need `store.share`
  // to cross; with no agent-private store traffic, the one workspace IS the shared place.)
  use store.workspace(path = "concierge")

  @"Where the curator speaks, and the app's reporting channel of last resort — so a dropped note here
  has nowhere better to go. That is honest to leave: the durable notes are the source of truth, so a
  lost confirmation costs a re-ask, never a fact."
  agent operator_note(reply: string) -> null with discord.credential | io | prelude.throw[discord.auth_error] {
    let bounded = string.fit(value = reply, cap = discord.limits().message_text, marker = " …(cut)")
    match (discord.try_send(channel = control_channel, text = bounded)) {
      case discord.delivered(_) -> null
      case discord.dropped(reason => _) -> null
    }
  }

  @"Where the face speaks. A reply the channel never saw is reported where somebody can act, rather
  than letting the silence pass as delivery."
  agent face_reply(reply: string) -> null with discord.credential | io | prelude.throw[discord.auth_error] {
    let bounded = string.fit(value = reply, cap = discord.limits().message_text, marker = " …(cut)")
    match (discord.try_send(channel = public_channel, text = bounded)) {
      case discord.delivered(_) -> null
      case discord.dropped(reason => reason) -> operator_note(reply = f"(a public reply was dropped: ${reason})")
    }
  }

  @"The two lines an outage costs the OWNER, and it cannot flood: `with_breaker` fires this on the
  STATE CHANGE and nowhere else, so an outage of any length is exactly one line out and one back. The
  wording is the package's because the judgement is (`outage_kind` says who can end the outage, and
  names the remedy when it is a person); where it goes is ours, and it goes to the private channel
  precisely because a remedy is information for the one person who can act on it. The community's own
  copy of that news arrives separately — `serve_observations` tells the face's conversation, which
  delivers it to the public channel."
  agent announce_outage(event: ai.breaker_event) -> null with discord.credential | io | prelude.throw[discord.auth_error] {
    match (event) {
      case ai.breaker_opened(kind => kind) -> operator_note(reply = ai.outage_line(kind = kind))
      case ai.breaker_closed(kind => _) -> operator_note(reply = ai.recovery_line())
    }
  }

  @"The published-notes index, re-read fresh at every model step for BOTH AIs — so a note the curator
  publishes mid-conversation is visible on the face's very next turn, with no restart. It is ambient
  rather than per-agent because the notes are the one thing both agents work from."
  agent published_notes(value: null) -> string with store.get | store.set | store.delete | store.list {
    memory.index_note()
  }

  // THE TWO TOOL SETS ARE THE MEMBRANE, and they are just data. The face gets three READS and the
  // flag; the curator gets the same reads plus the two WRITES. No write reaches the face, and no
  // channel reaches either — an AI here speaks only through its `deliver_to`.
  let face_tools = [memory.recall, memory.search, memory.list_memories, flag_unknown]
  let curator_tools = [memory.recall, memory.search, memory.list_memories, memory.remember, memory.forget]

  let nursery: region.nursery[concierge_scope, concierge_ceiling] = use region.provide[concierge_scope, concierge_ceiling]

  // THE ROUTER'S OWN `mail_scope` DISCHARGE — the deliberate marker merge. This nursery holds nothing
  // and is never watched; it exists so the handler below may hold mailbox handles and fork into them at
  // all. The merge is a TYPE-level phenomenon only: a fork routes by the handle's own runtime scope
  // identity, which `provide` mints freshly per install, so no report can land in the wrong inbox.
  let _outbound: ai.mailbox = use region.provide[ai.mail_scope, ai.observation]

  // THE ROUTER — ONE handler, because both requests share the `boxes` var. `register` arrives once per
  // AI, from inside that AI's own `provide`; `send_mail` arrives from a channel watcher or from the
  // face's flag tool. Delivery is a FORK INTO THE ADDRESSEE'S NURSERY, which is the only way to reach
  // another fiber's conversation: an `observation` performed anywhere reaches whatever serving handler
  // is above the PERFORMER, never the AI it was meant for.
  //
  // `ai.mail` is a NAMED agent applied to PLAIN DATA, and that is not a style choice — a cross-nursery
  // fork carries its task's captured environment into the target's instance, so an inline closure would
  // hand this router's own handlers to a scope that may die first. There is nothing to capture here.
  //
  // Delivery is AT-MOST-ONCE: a fork into a nursery that has already died PANICS rather than answering.
  // Nothing folds that here, deliberately — a dead inbox means the AI itself died, which the root
  // watch's `crashed` clause reports one moment later, and the panic itself is folded where it lands
  // (inside a tool dispatch, by the turn loop; inside a watcher, by that watcher's own supervisor).
  //
  // NOTHING DAMPS `hop` HERE, and the reason is worth stating rather than leaving as an omission: mail
  // runs ONE WAY in this program — only the face sends, only the curator receives, and the curator has
  // no mail tool — so there is no relay loop to cut. `hop` is provenance the model reads. A program
  // where two AIs can both send is where a `hop >= 2` refusal belongs, and this is the handler it
  // belongs in.
  use handler (var boxes: record[ai.mailbox] = {}) {
    request ai.register(name: string, box: ai.mailbox) {
      // A resident forked again after a crash registers again under the same name, so this write is
      // also the repair: the stale handle is replaced without anyone reconciling anything.
      next null with { boxes = record.set(target = boxes, key = name, value = box) }
    }
    request send_mail(to: string, source: string, content: string, hop: integer, files: array[file], author: string | null) {
      match (record.get(target = boxes, key = to)) {
        case null -> { next f"(there is no agent named ${to} running right now, so nothing was delivered.)" with { boxes = boxes } }
        case box -> {
          let _fiber = region.fork(
            nursery = box,
            task = ai.mail,
            argument = { source = source, content = content, hop = hop, files = files, author = author },
            name = f"mail->${to}",
          )
          next f"(delivered to ${to}.)" with { boxes = boxes }
        }
      }
    }
  }

  // ONE LINE PER AI, spelled once here so boot and the crash policy cannot disagree about what a
  // "face" is. `E` is instantiated explicitly because a fork takes the task as a VALUE, not as a call,
  // so nothing infers its type arguments there.
  agent start_face() -> null with concierge_scope | io {
    let _fiber = region.fork(
      nursery = nursery,
      task = ai.resident[resident_effects],
      argument = { name = "face", tools = face_tools, deliver_to = face_reply, max_steps = 16, persona = face_persona() },
      name = "face",
    )
    null
  }

  agent start_curator() -> null with concierge_scope | io {
    let _fiber = region.fork(
      nursery = nursery,
      task = ai.resident[resident_effects],
      argument = { name = "curator", tools = curator_tools, deliver_to = operator_note, max_steps = 16, persona = curator_persona() },
      name = "curator",
    )
    null
  }

  // WHAT A FIBER'S DEATH MEANS. There are three kinds of fiber under this nursery and the name tag
  // tells them apart. A WATCHER never crashes — it supervises itself, and only a budget it could not
  // keep escapes, as a throw. A `mail->…` fiber is one report and nothing more. An AI is the one case
  // worth acting on: a panic there is a call the runtime interrupted mid-turn, and the conversation
  // dies with the fiber, so it is started again — the fresh resident re-registers itself, which repairs
  // the router — and the owner is told what the restart cost. `failed` is the other ending: a fault no
  // fresh start fixes leaves a concierge standing over a channel nobody is listening to. Alive, and
  // deaf. So the channel gets the line while it still can, and the run STOPS: a stopped run is a fact
  // somebody notices.
  use handler {
    request region.crashed(id: string, name: string, message: string) {
      match (name) {
        case "face" -> {
          operator_note(reply = f"(the face was interrupted mid-turn (${message}) and its conversation is lost. It is starting again — the published notes are untouched, and the message it was answering went unanswered.)")
          start_face()
          next null
        }
        case "curator" -> {
          operator_note(reply = f"(the curator was interrupted mid-turn (${message}) and its conversation is lost. It is starting again — the published notes are untouched.)")
          start_curator()
          next null
        }
        case other -> {
          operator_note(reply = f"(fiber ${other} crashed: ${message} — it was one errand, so nothing is started again.)")
          next null
        }
      }
    }
    request region.failed(id: string, name: string, error: unknown) {
      operator_note(reply = f"(fiber ${name} stopped on an error no fresh start fixes: ${json.stringify(value = error)} — the concierge is stopping.)")
      prelude.throw(error = fiber_died(name = name, detail = json.stringify(value = error)))
    }
  }

  start_face()
  start_curator()
  let _public = region.fork(nursery = nursery, task = public_watcher, argument = { channel = public_channel }, name = "public-watcher")
  let _control = region.fork(nursery = nursery, task = control_watcher, argument = { channel = control_channel }, name = "control-watcher")

  // THE THREE MIDDLEWARES, wrapping the ROOT WATCH so that every AI's step passes through all of them:
  // a fiber does not inherit the handlers of whoever forked it, so anything installed beside a fork
  // would reach nobody. Reading a step's path inward-out: the BREAKER decides whether to call at all,
  // the ambient NOTES INDEX is derived and injected, and the PROVIDER makes the call. The residents'
  // own `persona` injections sit inside their fibers and re-perform outward through all three.
  use anthropic.provider(source = credentials.env(key = "ANTHROPIC_API_KEY"))
  use ai.with_context(inject = published_notes)
  use ai.with_breaker(on_transition = announce_outage)
  region.watch(nursery = nursery)
}

// ── the entry ─────────────────────────────────────────────────────────────────────────────────────

@"One env entry read as configuration: `null` when unset OR blank, so an empty value cannot
half-configure a channel."
agent configured(key: string) -> string | null {
  match (string.trim(value = env.get_or(key = key, fallback = ""))) {
    case "" -> null
    case value -> value
  }
}

@"Entry: validate the two channel ids, then serve forever. Boot refuses a missing channel, and
refuses the two channels being ONE channel — that would collapse the membrane, since every
community member could then talk to the curator."
agent main() -> string {
  match (configured(key = "PUBLIC_CHANNEL")) {
    case null -> "refused to start: PUBLIC_CHANNEL is not set — `katari env set PUBLIC_CHANNEL <channel id>`."
    case public_channel -> {
      match (configured(key = "CONTROL_CHANNEL")) {
        case null -> "refused to start: CONTROL_CHANNEL is not set — `katari env set CONTROL_CHANNEL <channel id>`."
        case control_channel -> {
          if (public_channel == control_channel) {
            "refused to start: PUBLIC_CHANNEL and CONTROL_CHANNEL are the same channel — the control channel is the membrane, and one shared channel would let every member curate the notes."
          } else {
            serve(public_channel = public_channel, control_channel = control_channel)
          }
        }
      }
    }
  }
}
