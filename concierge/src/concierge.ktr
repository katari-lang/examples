// A two-desk community concierge — the second-agent guide's geometry, with real packages.
// A public FACE answers questions in the community channel; its owner curates what it knows
// from a private CONTROL channel. The membrane is the face's tool set: every tool it holds
// reads the shared notes (or flags a question), the control desk is the only writer, and the
// notes live in the durable store — so what the face knows is exactly what was published,
// and no instance failure can ever edit it.

import ai
import ai.anthropic
import discord
import memory

// ── the bus: one request per serialization domain, plus the face's one outward capability ─────────

@"The face desk's inbox: one message from the public community channel, already framed for the
model (speaker introduced, identity tagged)."
request face_message(
  @"The line the model reads: the speaker's frame, then their text." content: string,
  @"The message's attachments." files: array[file],
  @"The speaker's pseudonymous tag, for abuse attribution — never a raw user id." author: string,
) -> null

@"The control desk's first inbox: one operator line from the private control channel, exactly
as typed — parsing is the desk's job."
request control_message(text: string) -> null

@"The control desk's second inbox: a question the face could not answer from the notes. It
arrives as MAIL, never as a call, so the face's turn finishes whatever the owner does with it."
request question_flagged(@"The question, in the asker's words." question: string) -> null

@"Mail `question_flagged` to the control desk, answering with a confirmation for the model to
read. Served by the flag bridge, which holds the nursery handle on the desks' behalf — so no desk
and no tool ever touches `region.post` or another desk's request."
request flag_question(@"The question to flag." question: string) -> string

@"The region's scope marker: one nullary phantom per nursery."
effect concierge_scope

// Everything a fiber of the one nursery may raise: the desks' inboxes, the flag mail, the bot token
// the watchers listen with, and io.
type concierge_ceiling = face_message | control_message | question_flagged | discord.credential | io

@"A fiber's THROW escaped every fold it had — a revoked token, a channel the bot lost access to, a
credential that stopped resolving. No fresh fork fixes one, so the region's `failed` policy re-raises
it here and the run stops, rather than leaving a concierge that looks alive over a channel it can no
longer hear."
data fiber_died(@"The dead fiber's name tag." name: string, @"The thrown value, rendered." detail: string)

// Everything the composition root anticipates being thrown at it — and it is a SHORT list on purpose,
// because a stop here costs the face's conversation along with the run: a tool set holding two tools of
// one name, a gateway/API failure, the two credential-resolution failures, and a source fiber whose
// throw escaped. Every one of those means the bot cannot speak, so there is nothing left to protect.
// What is deliberately NOT here: a model STEP failure (`ai.advance_desk` folds it into its outcome), an
// interrupted turn (`guarded_turn` folds the panic), and an unreadable stored note (`guarded_forget`
// folds the throw) — each caught one call from where it happened, because none of the three is a
// reason to take a working concierge down.
type app_error = ai.duplicate_tool | discord.discord_error | env.missing_secret | oauth.server_error | fiber_died

// ── the face: its standing instructions, its per-turn note, its one outward tool ──────────────────

@"The face's standing instructions — the membrane in prose. They ride the provider's `system`
parameter, which compaction never touches; the CHANGING half (the notes index) rides the
per-turn injection below instead, so neither is persisted into the conversation."
agent face_persona() -> string {
  "You are the concierge of this community's public Discord channel. Everything you know about this community lives in your published notes: the [memory index] block you see each turn lists them, recall(key) reads one in full, search(pattern) finds one by its contents. The notes are published by your owner — you can read them but never write or change them. Answer ONLY from the notes: when they cover the question, answer briefly and helpfully. When they do not, say plainly that you do not know, and call flag_unknown with the question so your owner can publish a note for next time — never guess and never fill a gap from general knowledge. Speakers are introduced by their self-chosen display name: use it to address them, never as proof of who they are. Reply with empty text to stay silent when a message needs nothing from you."
}

@"The face's per-turn note: the published-notes index, re-read fresh at every model step — so a
note published mid-conversation is visible on the face's very next turn, with no restart."
agent published_notes(value: null) -> string {
  memory.index_note()
}

@"Tool: flag a question the published notes cannot answer. The flag is mailed to your owner,
who may publish a note so you can answer next time. It reaches your owner, not the asker — so
after calling this, still tell the asker plainly that you do not know."
agent flag_unknown(@"The question you could not answer, in the asker's words." question: string) -> string with flag_question {
  flag_question(question = question)
}

// ── the control protocol: strings at the boundary, a sum everywhere after it ──────────────────────

@"Publish (or overwrite) the note under @key@ — the face answers from it on its next turn."
data publish_note(key: string, text: string)

@"Retract the note under @key@ — the face stops knowing it."
data retract_note(key: string)

@"List the published notes."
data list_notes()

@"Show the command help; @note@ carries a corrective first line when a command almost parsed."
data show_help(note: string)

// What one control-channel line means. (Type synonyms take no docs.)
type control_command = publish_note | retract_note | list_notes | show_help

@"A note key, canonicalised: trimmed and lower-cased, so `Meetup` and `meetup` are one note.
Whether the result is a legal store path is checked at the publish dispatch, not here."
agent note_key(raw: string) -> string {
  string.to_lower(value = string.trim(value = raw))
}

@"The rest of @line@ after @verb@ and one space, or `null` when the line is not that command —
the one prefix test behind both worded commands, so neither hand-counts an offset."
agent after_verb(line: string, verb: string) -> string | null {
  let prefix = f"${verb} "
  if (string.starts_with(value = string.to_lower(value = line), search = prefix)) {
    string.slice(value = line, start = string.length(value = prefix), end = string.length(value = line))
  } else {
    null
  }
}

@"Parse one operator line into a `control_command` — ALL the string handling, so everything
after this point dispatches on the sum. The grammar is one verb per message: `publish <key>:
<text>`, `retract <key>`, `notes`, `help`; anything else is answered with the help."
agent parse_command(text: string) -> control_command {
  let line = string.trim(value = text)
  match (string.to_lower(value = line)) {
    case "notes" -> list_notes()
    case "help" -> show_help(note = "")
    case _ -> {
      match (after_verb(line = line, verb = "publish")) {
        case null -> {
          match (after_verb(line = line, verb = "retract")) {
            case null -> show_help(note = "(that is not a command I know.)")
            case rest -> {
              let key = note_key(raw = rest)
              if (string.is_blank(value = key)) {
                show_help(note = "(retract needs a key.)")
              } else {
                retract_note(key = key)
              }
            }
          }
        }
        case rest -> {
          // The FIRST colon splits key from text, so the text itself may contain colons.
          match (string.index_of(value = rest, search = ":")) {
            case null -> show_help(note = "(publish needs a colon between the key and the text.)")
            case at -> {
              let key = note_key(raw = string.slice(value = rest, start = 0, end = at))
              let body = string.trim(value = string.slice(value = rest, start = at + 1, end = string.length(value = rest)))
              if (string.is_blank(value = key) || string.is_blank(value = body)) {
                show_help(note = "(publish needs both a key and a text.)")
              } else {
                publish_note(key = key, text = body)
              }
            }
          }
        }
      }
    }
  }
}

@"A note whose STORED shape this version no longer reads — hand-edited, or written by an older build.
A VALUE, because one unreadable row is not a reason to take the concierge down: the owner is told which
key to look at and every other note keeps answering. It is the one throw `memory.forget` can raise, and
it can only reach a program that calls `forget` directly, as this desk does."
data unreadable_note(@"The validation failure, rendered." detail: string)

// How one retraction ended: memory's own two answers, plus the one the store can hand back.
// (Type synonyms take no docs.)
type retraction = memory.forgot | memory.was_absent | unreadable_note

@"Retract @key@, TOTALLY — the desk dispatches on three arms and never on a throw. `forget` decides
`forgot` / `was_absent` inside the critical section that does the removal, and raises
`json.validation_error` for a row it cannot read; that last one is caught HERE, one call away from where
it happened, rather than at the root where it would end the run and take the face's conversation with
it."
agent guarded_forget(key: string) -> retraction with store.exclusive {
  use handler {
    request prelude.throw(error: json.validation_error) -> never {
      break unreadable_note(detail = json.stringify(value = error))
    }
  }
  memory.forget(key = key)
}

@"The control protocol, as the reply to `help` and to anything unparsed."
agent help_text() -> string {
  "publish <key>: <text> — publish (or overwrite) a note; the face answers from it immediately. Keys are lower-cased; use letters, digits, - and _, with / to group (faq/meetup).\nretract <key> — remove a note; the face stops knowing it.\nnotes — list the published notes.\nhelp — this text."
}

// ── the sources: the two channels, arriving as escalations ────────────────────────────────────────

@"The PUBLIC-channel source: serve the community channel forever, each message becoming face
mail. `watch_messages` subscribes to ONE channel, so two channels are honestly two fibers —
there is no single stream here to route. The speaker's snowflake is tagged before it leaves the
program (`discord.author_tag`, an HMAC under the bot token): the full tag rides `author` for
abuse attribution, a short slice rides the content so the model can tell speakers apart, and
the display name is framed as what it is — self-chosen, for address, never for trust."
agent face_source(input: string) -> never with concierge_ceiling | prelude.throw[discord.discord_error | env.missing_secret | oauth.server_error] {
  // THE WATCH RESTARTS ITSELF. A runtime restart interrupts this call and the frame panics; the
  // converter makes that the replay signal and the provider opens a fresh gateway after a backoff —
  // the token is the whole of what a watch needs, so there is nothing stale to inherit. The boundary
  // is INSIDE the fiber, so the desks' state, which lives above it, is not rebuilt by a re-run. Five
  // attempts in: a restart spends one and the next succeeds, while a defect that panics every time
  // reproduces on every attempt settles at the delay ceiling — one attempt every fifteen minutes,
  // visible in the run's events. `forever`, not `exponential`: a bounded budget is a LIFETIME count
  // that never resets, so it would kill a watch meant to outlive every deploy on its fifth restart.
  use supervise.forever(initial_delay_milliseconds = 1000.0, factor = 2.0, max_delay_milliseconds = 900000.0)
  use supervise.signal_panics[never]()
  agent deliver(value: discord.message) -> null with face_message | io | prelude.throw[env.missing_secret | oauth.server_error] {
    let hashed = discord.author_tag(source = credentials.env(key = "DISCORD_TOKEN"), author = value.author, length = 64)
    let tag = string.slice(value = hashed, start = 0, end = 8)
    face_message(
      content = f"[from \"${value.display_name}\" — a self-chosen name; user ${tag} is the identity] ${value.text}",
      files = value.files,
      author = hashed,
    )
  }
  discord.watch_messages(channel = input, deliver_to = deliver)
}

@"The CONTROL-channel source: the owner's private channel, served forever. The raw line is all
the desk needs — no model reads it and no identity leaves the program, so nothing is tagged
here; the channel's MEMBERSHIP is the trust boundary. Opening the gateway is the watch's own job, so
a Discord failure to open it is a throw from here — `region.failed`, not a crash to fork again."
agent control_source(input: string) -> never with concierge_ceiling | prelude.throw[discord.discord_error] {
  // As the face watch: it restarts itself, unbounded, with the delay ceiling as the only brake.
  use supervise.forever(initial_delay_milliseconds = 1000.0, factor = 2.0, max_delay_milliseconds = 900000.0)
  use supervise.signal_panics[never]()
  discord.watch_messages(channel = input, deliver_to = agent (value: discord.message) -> null {
    control_message(text = value.text)
  })
}

// ── the composition root ──────────────────────────────────────────────────────────────────────────

@"One resident session: the fatal guard, the two providers, the one shared workspace, the nursery,
the flag bridge, the two desks, the crash policy, the two watchers — then pump the bus forever. It
returns only through the fatal guard, so the returned string is the stop report."
agent serve(public_channel: string, control_channel: string) -> string {
  // THE FATAL GUARD, outermost: a revoked token or a missing secret answers the same however often it
  // is retried, so every anticipated throw ends the run LOUDLY. Absorbing an auth-shaped failure
  // would leave a bot that looks alive and answers nothing. The panic clause keeps the stop report
  // TOTAL: a panic this far up is a Discord call the runtime interrupted on a DESK's path (a fiber's
  // is `region.crashed` below, and forked again), which stops the run readably.
  use handler {
    request prelude.throw(error: app_error) -> never { break f"stopped: ${json.stringify(value = error)}" }
  }
  use handler { request panic(msg: string) { break f"stopped on a defect or an interrupted call: ${msg}" } }
  // NEITHER PROVIDER CONNECTS ANYTHING — `discord.provider` serves the bot token, resolved per call,
  // and a call that needs the gateway opens one for its own lifetime. So nothing installed below can
  // be invalidated by a runtime restart: it all stays put across one, INCLUDING the face desk's
  // conversation, and an interrupted watch is forked again by the crash policy near the bottom.
  use anthropic.provider(source = credentials.env(key = "ANTHROPIC_API_KEY"), system = face_persona())
  use discord.provider(source = credentials.env(key = "DISCORD_TOKEN"))
  // THE ONE WORKSPACE — place and serial domain in one install, and the sharing is the
  // geometry: neither desk opens a workspace of its own, so the memory facility resolves to
  // the same `concierge/memory/…` from the face's read tools and the control desk's writes
  // alike, and the facility's write sections serialize at this install's FIFO. (Per-desk
  // workspaces would need `store.share` to cross; with no desk-private store traffic, the one
  // workspace IS the shared place.)
  use store.workspace(path = "concierge")

  agent operator_note(text: string) -> null {
    // The control channel is the reporting channel of last resort, so a dropped note here has
    // nowhere better to go. That is honest to leave: the durable notes are the source of
    // truth and `notes` re-reads them, so a lost confirmation costs a re-ask, never a fact.
    match (discord.try_send(channel = control_channel, text = discord.fit_message(text = text, marker = " …(cut)"))) {
      case discord.delivered(_) -> null
      case discord.dropped(reason => _) -> null
    }
  }

  agent face_reply(reply: string) -> null {
    match (discord.try_send(channel = public_channel, text = discord.fit_message(text = reply, marker = " …(cut)"))) {
      case discord.delivered(_) -> null
      // The channel never saw this reply and nothing will retry it — report it where someone
      // can act instead of letting the silence pass as delivery.
      case discord.dropped(reason => reason) -> operator_note(text = f"(a public reply was dropped: ${reason})")
    }
  }

  // The face's whole capability, as data — the membrane IS this list: three READS of the
  // shared notes, and the flag. No write reaches the face. The memory tools go over raw
  // because their docs cross-reference each other by name (recall points at list_memories);
  // the persona reframes whose notes they are.
  let face_tools = [memory.recall, memory.search, memory.list_memories, flag_unknown]

  let nursery: region.nursery[concierge_scope, concierge_ceiling] = use region.provide[concierge_scope, concierge_ceiling]

  // THE FLAG BRIDGE — below the nursery because it needs the handle, above the face desk
  // because the face's tool performs `flag_question` from that desk's install site. Mail is a
  // fiber whose whole body is one perform: it queues in the region's durable mailbox BEHIND
  // the turn that sent it, so a mid-turn flag can never re-enter a busy desk. The guide's hop
  // counter has nothing to count here — the mail runs one way and the control desk never mails
  // onward, so there is no relay loop to damp.
  use handler {
    request flag_question(question: string) {
      let _mail = region.post(
        nursery = nursery,
        task = agent () -> null with question_flagged { question_flagged(question = question) },
        name = "flag->control",
      )
      next "(flagged for the owner. They may publish a note; until then, tell the asker you do not know.)"
    }
  }

  // THE FACE DESK — one sequential handler, one `ai.desk` var: the conversation is run state, and
  // nothing above it is rebuilt, so it SURVIVES a runtime restart. `model_down` makes outage notices
  // TRANSITION-only, so a dead provider costs the channels one line each, not one per message.
  use handler (var face: ai.desk = ai.new_desk(), var model_down: boolean = false) {
    request face_message(content: string, files: array[file], author: string) {
      // ONE TURN, RUN ONCE. Unlike a watch, a turn must NOT re-run: `deliver_to` may already have posted
      // the reply, so a retry is a double post — and the desk's conversation is run state, so letting the
      // panic reach the root would cost every message ever said in the channel to pay for one arrival
      // nobody could have answered. Same converter as the watches, the other mechanism under it.
      let state = face
      let arrival = ai.arrival(source = "public-channel", content = content, hop = 0, files = files, author = author)
      match (supervise.once(task = agent () -> ai.desk_turn {
        use supervise.signal_panics[never]()
        ai.advance_desk(state = state, arrival = arrival, tools = face_tools, persona = published_notes, deliver_to = face_reply)
      })) {
        case supervise.signalled(failure => reason) -> {
          // Nothing about the desk was advanced, so `face` stays exactly as the last completed turn
          // left it. The asker heard nothing and nothing will retry for them — say so where somebody
          // can act on it, and keep serving.
          operator_note(text = f"(a face turn was interrupted and is lost: ${reason.message}. The conversation is intact; that one message went unanswered.)")
          next null
        }
        case supervise.ran(value => advanced) -> {
          match (advanced.outcome) {
            case ai.answered(reply => _) -> {
              // A non-blank reply already left through `face_reply`; a blank one is silence by
              // protocol. Coming back from an outage is worth one line to the owner — the held
              // messages just rejoined this very turn.
              if (model_down) { operator_note(text = "(the face's model is answering again.)") } else { null }
              next null with { face = advanced.state, model_down = false }
            }
            case ai.filed(held => _, dropped => _) -> {
              // Reachable only under `ai.with_breaker`, which this program does not install. The
              // outcome sum carries the arm, so the fold says so instead of inventing behaviour.
              next null with { face = advanced.state }
            }
            case ai.step_failed(error => error) -> {
              // The arrival is already FILED in the desk's backlog and rejoins the next turn, so the
              // public line promises exactly that and nothing more — `ai.outage_line`'s wording is not
              // ours to borrow, since it promises that calling has STOPPED, which is only true under a
              // breaker this program does not install. No retry here either: the provider spent its own
              // retry budget before this outcome existed.
              if (model_down) {
                null
              } else {
                face_reply(reply = "(I cannot think right now — your message is kept, and I will answer as soon as I can.)")
                match (ai.classify_outage(error = error)) {
                  case ai.needs_operator(remedy => remedy) -> operator_note(text = f"(the face's model call failed and will not heal on its own: ${remedy})")
                  case ai.waits_out(_) -> operator_note(text = f"(the face's model call failed — likely transient: ${json.stringify(value = error)}. Held messages rejoin the next successful turn.)")
                }
              }
              next null with { face = advanced.state, model_down = true }
            }
          }
        }
      }
    }
  }

  // THE CONTROL DESK — sequential and var-free: the notes themselves are the state, durable in
  // the store, so a restart forgets nothing and only this desk's command path ever writes.
  // Serving BOTH requests in one handler puts owner commands and face flags on ONE FIFO, so a flag
  // can never land in the middle of the command it arrived during. That is a claim about these two
  // and not about the channel: the face desk's outage lines and the crash policy's reports reach
  // `operator_note` without passing here, and each is one whole post with nothing to interleave.
  use handler {
    request control_message(text: string) {
      match (parse_command(text = text)) {
        case publish_note(key => key, text => body) -> {
          // A note key becomes a store path inside the memory facility, so it is held to the
          // store's own definition of one. An odd key (a stray space, a `..`) would store and read
          // back, but the owner and the face must both spell it afterwards — so it is refused
          // while there is still somebody to correct.
          if (store.is_safe_path(path = key)) {
            let replaced = record.has(target = memory.index(), key = key)
            // The one text serves as both halves of a memory note — the index line the face
            // sees every turn, and the body `recall` reads. One `remember` writes both, so
            // they cannot drift; the confirmation below is ours, not the tool's model-facing
            // one.
            let _confirmation = memory.remember(key = key, summary = body, body = body)
            let verb = if (replaced) { "replaced" } else { "published" }
            operator_note(text = f"(${verb} \"${key}\" — the face answers from it on its next turn.)")
          } else {
            operator_note(text = f"(refused: \"${key}\" cannot be a note key — use lowercase letters, digits, - and _, with / to group.)")
          }
          next null
        }
        case retract_note(key => key) -> {
          // The call itself says which ending it had, so an owner who retracts a typo is never
          // told something was removed. Reading the index first would answer the same question
          // one race narrower — memory decides this inside the section that does the removal.
          match (guarded_forget(key = key)) {
            case memory.forgot(_) -> {
              operator_note(text = f"(retracted \"${key}\" — the face no longer knows it.)")
            }
            case memory.was_absent(_) -> {
              operator_note(text = f"(nothing is published under \"${key}\" — send `notes` to see the keys.)")
            }
            case unreadable_note(detail => detail) -> {
              operator_note(text = f"(\"${key}\" is stored in a shape this version cannot read, so it was NOT retracted: ${detail}. Delete that row in the console; everything else still answers.)")
            }
          }
          next null
        }
        case list_notes(_) -> {
          operator_note(text = memory.list_memories())
          next null
        }
        case show_help(note => note) -> {
          let lead = if (string.is_blank(value = note)) { "" } else { f"${note}\n" }
          operator_note(text = f"${lead}${help_text()}")
          next null
        }
      }
    }
    request question_flagged(question: string) {
      operator_note(text = f"(the face was asked something the notes do not cover: \"${question}\" — `publish <key>: <text>` to teach it.)")
      next null
    }
  }

  // WHAT A FIBER'S DEATH MEANS — and there is much less of it to say now that each watch restarts
  // ITSELF. A panic inside a watch never reaches here: its own `replay` converter takes it, and only a
  // budget it could not keep escapes, as a THROW. So `crashed` is left with the case it was always
  // honest about — a one-shot mail, which is one lost flag and nothing more (the asker was already told
  // the face does not know) — and `failed` is the one real decision: a fault no fresh start fixes (the
  // token, the bot's access, a watch that panicked five times) leaves a desk standing over a channel
  // nobody is listening to. Alive, and deaf. So the channel gets the line while it still can, and the
  // run STOPS: a stopped run is a fact somebody notices.
  use handler {
    request region.crashed(id: string, name: string, message: string) {
      operator_note(text = f"(fiber ${name} crashed: ${message} — it was one errand, so nothing is started again.)")
      next null
    }
    request region.failed(id: string, name: string, error: unknown) {
      operator_note(text = f"(fiber ${name} stopped on an error no fresh start fixes: ${json.stringify(value = error)} — the concierge is stopping.)")
      prelude.throw(error = fiber_died(name = name, detail = json.stringify(value = error)))
    }
  }

  let _face_watcher = region.fork(nursery = nursery, task = face_source, argument = public_channel, name = "face-watcher")
  let _control_watcher = region.fork(nursery = nursery, task = control_source, argument = control_channel, name = "control-watcher")
  region.watch(nursery = nursery)
}

// ── the entry ─────────────────────────────────────────────────────────────────────────────────────

@"One env entry read as configuration: `null` when unset OR blank, so an empty value cannot
half-configure a channel."
agent configured(key: string) -> string | null {
  match (env.get(key = key)) {
    case null -> null
    case value -> {
      if (string.is_blank(value = value)) {
        null
      } else {
        string.trim(value = value)
      }
    }
  }
}

@"Entry: validate the two channel ids, then serve forever. Boot refuses a missing channel, and
refuses the two channels being ONE channel — that would collapse the membrane, since every
community member could then publish."
agent main() -> string {
  match (configured(key = "PUBLIC_CHANNEL")) {
    case null -> "refused to start: PUBLIC_CHANNEL is not set — `katari env set PUBLIC_CHANNEL <channel id>`."
    case public_channel -> {
      match (configured(key = "CONTROL_CHANNEL")) {
        case null -> "refused to start: CONTROL_CHANNEL is not set — `katari env set CONTROL_CHANNEL <channel id>`."
        case control_channel -> {
          if (public_channel == control_channel) {
            "refused to start: PUBLIC_CHANNEL and CONTROL_CHANNEL are the same channel — the control channel is the membrane, and one shared channel would let every member publish."
          } else {
            serve(public_channel = public_channel, control_channel = control_channel)
          }
        }
      }
    }
  }
}
